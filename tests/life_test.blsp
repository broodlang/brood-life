;; Tests for the life simulation core. The render loop (`run-life`) takes over the
;; window, so exercise it with `nest run --for 2s` instead. The board is a bitboard
;; (`bitboard` module): build one with `make` + `bset`, inspect it with `cells`
;; (live `[x y]` list) and `live-count` (population).
(defmodule life-test (:use life) (:use bitboard) (:use test))

(defn board (coords)
  "A 120×40 bitboard with `coords` (a list of `[x y]`) live."
  (reduce (fn (b [x y]) (bset b x y)) (make 120 40) coords))

; a right click adds a full glider gun
(describe "life"
  (test "a blinker oscillates with period 2"
    (let (b (board [[1 0] [1 1] [1 2]]))
      (do
        (assert= (sort (cells (step b))) (sort [[0 1] [1 1] [2 1]]))
        (assert= (sort (cells (step (step b)))) (sort (cells b))))))

  (test "a glider translates by (+1,+1) every 4 generations"
    (let (g (board [[1 0] [2 1] [0 2] [1 2] [2 2]])
          g4 (step (step (step (step g)))))
      (assert= (sort (cells g4))
        (sort (map (fn ([x y]) [(+ x 1) (+ y 1)]) (cells g))))))

  ; -> horizontal, row 0
  (test "the torus wraps top-to-bottom: a blinker across the top edge rotates normally"
    (let (vertical (board [[1 39] [1 0] [1 1]]))
      ; col 1, rows 39/0/1 — straddles the top
      (assert= (sort (cells (step vertical))) (sort [[0 0] [1 0] [2 0]]))))
  (test "a seeded board is deterministic, non-empty, and on-grid"
    (let (s (seed 42))
      (do
        ; same seed -> same board
        (assert= (sort (cells s)) (sort (cells (seed 42))))
        (is (> (live-count s) 0))
        (is (every? (fn ([x y]) (and (>= x 0) (< x 120) (>= y 0) (< y 40))) (cells s))))))

  (test "different seeds give different boards"
    (is (not (= (sort (cells (seed 1))) (sort (cells (seed 9)))))))

  (test "a left click drops a shape, a right click drops a 36-cell gun"
    (let (blank (make 120 40)
          [shape-drop _] (apply-clicks blank [[10 10 :shape]] 3)
          [gun-drop _] (apply-clicks blank [[10 10 :gun]] 3))
      (do
        ; the app starts empty
        (is (= (live-count blank) 0))
        ; a left click adds a shape
        (is (> (live-count shape-drop) 0))
        (assert= (live-count gun-drop) 36)))))
;; Shooters: the anti-stagnation guns. A gun keeps emitting gliders, so `inject-pattern`
;; sowing one onto a settled board makes the population trend up again. A one-cell typo
;; in *gosper-gun* would silently break it.
(defn stepn (b n) (reduce (fn (acc _) (step acc)) b (range n)))

; same seed -> same sow
(describe "shooters re-energise a stagnant board"
  (test "the Gosper gun fires: it emits gliders, so the population grows"
    (let (g (board *gosper-gun*))
      ; at origin, fits 120x40 without wrapping
      (do
        (assert= (live-count g) 36)
        (is (> (live-count (stepn g 60)) (live-count g))))))

  (test "the shooter set is eight 36-cell orientations of the gun, on a non-negative origin"
    (do
      (assert= (count *shooters*) 8)
      (is (every? (fn (s) (= (count s) 36)) *shooters*))
      (is (every? (fn (s) (every? (fn ([x y]) (and (>= x 0) (>= y 0) (<= x 35) (<= y 35))) s))
            *shooters*))))

  (test "inject-pattern sows a known pattern onto a flat board, deterministically"
    (let (settled (board [[0 0] [1 0] [0 1] [1 1]])
          ; a still-life block: population flat
          [revived _] (inject-pattern settled 7)
          [again _] (inject-pattern settled 7))
      (do
        ; a pattern was sown in
        (is (> (live-count revived) (live-count settled)))
        (assert= (sort (cells revived)) (sort (cells again)))))))
;; The reaper hunts the OLDEST live cell, found from the age layer (bit index -> birth-gen).
;; `age-step` carries that layer across a generation. The bug: a cell spawned this gen and
;; surviving the step was treated as a survivor — kept an age it never had, left ageless and
;; invisible to the reaper ("the reaper does not reap if the cell don't change"). The fix is
;; to feed `age-step` the PRE-spawn board, so such a cell falls into `born` and is stamped.
(describe "the reaper age layer"
  ; the dead cell is dropped
  (test "age-step drops the dead, keeps survivors' birth-gen, and stamps newcomers"
    (let (
          ; cells 0,1 alive last gen
          old (bit/or (bit/shift-left 1 0) (bit/shift-left 1 1))
          ; both born at gen 5
          ages {0 5 1 5}
          ; 1 survives, 0 dies, 7 appears
          new (bit/or (bit/shift-left 1 1) (bit/shift-left 1 7))
          stepped (age-step ages old new 9))
      (do
        ; survivor keeps its birth-gen
        (assert= (get stepped 1) 5)
        ; the newcomer is stamped "now"
        (assert= (get stepped 7) 9)
        (is (nil? (get stepped 0))))))
  (test "every live cell carries an age — none is left invisible to the reaper"
    ;; The invariant the reaper relies on: after a step, every set bit in the new board has
    ;; an age entry. Pre-spawn old = {0,1}; new (post-step) = {1,7,9}. With the fix, 7 and 9
    ;; (a spawn-and-survive plus a step newborn) are both stamped, not silently skipped.
    (let (old (bit/or (bit/shift-left 1 0) (bit/shift-left 1 1))
          new (reduce (fn (acc i) (bit/or acc (bit/shift-left 1 i))) 0 [1 7 9])
          stepped (age-step {0 2 1 2} old new 11))
      (is (every? (fn (i) (not (nil? (get stepped i)))) [1 7 9]))))

  (test "oldest-xy finds the smallest birth-gen, ties broken by nearness to the reaper"
    ;; w=120: idx 7 -> (7,0), idx 250 -> (10,2). Cell 7 is older (gen 3 < gen 8), so it wins.
    (assert= (oldest-xy {7 3 250 8} 120 0 0) [7 0])))

;; The renderer (render-loop) routes its mailbox on `quit-signal?`: the window's X
;; (`:close`) and the q / Esc / Ctrl-C keys quit; board/status/mouse/other don't.
;; The loop itself owns a GUI window so it's exercised live, not in the suite — but
;; the quit *decision* is a pure predicate, so we test that directly.
(describe "renderer quit signals"
  (test ":close / q / Esc / Ctrl-C are quit signals"
    (do
      (is (quit-signal? :close))
      (is (quit-signal? "q"))
      (is (quit-signal? :escape))
      (is (quit-signal? :ctrl-c))))
  (test "board / status / mouse / other messages are not quit signals"
    (do
      (is (not (quit-signal? [:board (board [[0 0]])])))
      (is (not (quit-signal? [:status "gen 0"])))
      (is (not (quit-signal? [:mouse :press :left 0 0 []])))
      (is (not (quit-signal? :drawn))))))
