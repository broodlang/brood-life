;; Tests for the life simulation core. The render loop (`run-life`) takes over
;; the terminal, so exercise it with `nest run --for 2s` instead.
(defmodule life-test (:use life) (:use test))

(defn board (coords) (into {} (map (fn (c) [c true]) coords)))

(describe "life"
  (test "a blinker oscillates with period 2"
    (let (b (board [[1 0] [1 1] [1 2]]))
      (do
        (assert= (sort (keys (step b))) (sort [[0 1] [1 1] [2 1]]))
        (assert= (sort (keys (step (step b)))) (sort (keys b))))))

  (test "a glider translates by (+1,+1) every 4 generations"
    (let (g (board [[1 0] [2 1] [0 2] [1 2] [2 2]])
          g4 (step (step (step (step g)))))
      (assert= (sort (keys g4))
        (sort (map (fn ([x y]) [(+ x 1) (+ y 1)]) (keys g))))))

  (test "neighbours wrap around the torus"
    (is (includes? (neighbours [0 0]) [119 39])))

  (test "a seeded board is deterministic, non-empty, and on-grid"
    (let (s (seed 42))
      (do
        (assert= (keys s) (keys (seed 42)))  ; same seed -> same board
        (is (> (count s) 0))
        (is (every? (fn ([x y]) (and (>= x 0) (< x 120) (>= y 0) (< y 40))) (keys s))))))

  (test "different seeds give different boards"
    (is (not (= (keys (seed 1)) (keys (seed 9)))))))

;; Shooters: the anti-stagnation guns. A gun keeps emitting gliders, so `inject-shooter`
;; sowing one onto a settled board makes the population trend up again (life--loop
;; calls it on stagnation). A one-cell typo in *gosper-gun* would silently break it.
(defn stepn (b n) (reduce (fn (acc _) (step acc)) b (range n)))

(describe "shooters re-energise a stagnant board"
  (test "the Gosper gun fires: it emits gliders, so the population grows"
    (let (g (board *gosper-gun*))           ; at origin, fits 120x40 without wrapping
      (do
        (assert= (count g) 36)
        (is (> (count (stepn g 60)) (count g))))))

  (test "the shooter set is four 36-cell reflections of the gun, each in its box"
    (do
      (assert= (count *shooters*) 4)
      (is (every? (fn (s) (= (count s) 36)) *shooters*))
      (is (every? (fn (s) (every? (fn ([x y]) (and (>= x 0) (<= x 35) (>= y 0) (<= y 8))) s))
            *shooters*))))

  (test "inject-shooter sows a gun onto a flat board, deterministically"
    (let (settled (board [[0 0] [1 0] [0 1] [1 1]])   ; a still-life block: population flat
          [revived _] (inject-shooter settled 7)
          [again _] (inject-shooter settled 7))
      (do
        (is (> (count revived) (count settled)))      ; a shooter was sown in
        (assert= (keys revived) (keys again))))))      ; same seed -> same sow

;; Parallel step (pstep): the torus is split into row-bands stepped on separate
;; processes, then stitched. The fan-out needs a live scheduler, but its CORRECTNESS
;; is the pure decomposition — band-parts (halo'd split) + band-step (owned-rows next
;; gen) must reassemble into EXACTLY (step board). We check that sequentially (no
;; spawn → deterministic), including the torus seam and a band count not dividing the
;; grid, then sanity-check pstep's serial fallback.
(defn band-merge (live k)
  (let (bh (max 1 (quot (+ *h* k -1) k)) subs (band-parts live k bh))
    (reduce (fn (acc b) (into acc (band-step (get subs b) (* b bh) (min *h* (* (+ b 1) bh)))))
      {} (range k))))

(describe "parallel step matches serial step"
  (test "row-band decomposition reassembles into exactly (step board)"
    (let (g (board [[1 0] [2 1] [0 2] [1 2] [2 2]    ; a glider
                    [10 0] [10 39] [11 39] [0 20]]))  ; cells on the torus seam (h=40)
      (do
        (assert= (band-merge g 8) (step g))           ; 8 bands
        (assert= (band-merge g 3) (step g))           ; band height not dividing h=40
        (assert= (band-merge (stepn g 5) 8) (step (stepn g 5))))))
  (test "pstep falls back to serial step below the threshold"
    (let (g (board [[1 0] [2 1] [0 2] [1 2] [2 2]]))
      (assert= (pstep g) (step g)))))

;; The frame loop's input handling — the "window won't close" bug was here: an
;; over-budget frame (deadline already passed) must STILL drain input, not skip it.
;; `wait-frame` reads this process's own mailbox, so we can drive it directly with a
;; deadline in the past (the over-budget case) without opening a window.
(describe "wait-frame stays responsive even past the frame deadline"
  (test "a queued :close (the window's X) quits, deadline already passed"
    (do (send (self) :close)
        (assert= (wait-frame (- (now-ns) 1000000) nil) :quit)))
  (test "q / Esc / Ctrl-C also quit past the deadline"
    (do (send (self) :escape)  (assert= (wait-frame (- (now-ns) 1000000) nil) :quit))
    (do (send (self) "q")      (assert= (wait-frame (- (now-ns) 1000000) nil) :quit))
    (do (send (self) :ctrl-c)  (assert= (wait-frame (- (now-ns) 1000000) nil) :quit)))
  (test "unrelated input is drained; the worker's next board is returned"
    (do (send (self) [:mouse :press :left 0 0])   ; ignored
        (send (self) [:gen (board [[0 0]])])       ; the next generation
        (assert= (wait-frame (- (now-ns) 1000000) nil) (board [[0 0]])))))
