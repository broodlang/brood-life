#!/usr/bin/env bash
# Spin up a particular implementation of the Life demo.
#
#   ./run                 # the Brood original (default)
#   ./run brood [args]    # the Brood original — nest run
#   ./run dotnet [args]   # the .NET port — ports/dotnet/Life
#
# Any extra args pass straight through, so the bounded-run flag works on either:
#   ./run brood  --for 2s
#   ./run dotnet --for 2s
#   ./run dotnet -- --selftest
#
# --fair starts EITHER engine from an identical setup for a head-to-head: a fixed
# 256x256 board seeded with a centred 100x100 block, uncapped. Both then evolve
# cell-for-cell the same, so the only difference you see is engine/render speed.
#   ./run brood  --fair
#   ./run dotnet --fair
# Override any knob via the env vars it sets: LIFE_BOARD=WxH LIFE_BLOCK=N LIFE_FPS=N.

set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

target="${1:-brood}"
[ $# -gt 0 ] && shift || true

# Intercept --fair: export the shared comparison config, drop it from the args.
fair_args=()
for a in "$@"; do
  if [ "$a" = "--fair" ]; then
    export LIFE_BOARD="${LIFE_BOARD:-256x256}"
    export LIFE_BLOCK="${LIFE_BLOCK:-100}"
    export LIFE_FPS="${LIFE_FPS:-0}"
    # The fair benchmark is uncoloured + no-zoom — exactly where the refc-shared bitset
    # board is a pure win (~5.7× the gen-rate), so default it on here. (Not a global
    # default: the bitset's view-zoom render path isn't ported, and normal coloured play
    # is render-bound so it wouldn't gain.) Override with LIFE_BITSET=0.
    export LIFE_BITSET="${LIFE_BITSET:-1}"
    # GPU backend, PER-PROCESS (the global nest stays CPU for every other app). Unsynced
    # present → the drawn frame rate isn't pinned to the monitor refresh. Safe here because
    # --fair is uncoloured (the board draws via the native [:cells] op; text glyphs aren't
    # on the GPU yet). Override with BROOD_GUI_GPU=0.
    export BROOD_GUI_GPU="${BROOD_GUI_GPU:-1}"
  else
    fair_args+=("$a")
  fi
done
set -- "${fair_args[@]+"${fair_args[@]}"}"

case "$target" in
  brood)
    cd "$here"
    exec nest run "$@"
    ;;
  dotnet|net|.net)
    cd "$here/ports/dotnet/Life"
    exec dotnet run -c Release "$@"
    ;;
  -h|--help|help)
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"
    ;;
  *)
    echo "run: unknown target '$target' (try: brood, dotnet, or --help)" >&2
    exit 2
    ;;
esac
