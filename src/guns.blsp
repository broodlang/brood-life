(defmodule guns
  "Glider GUNS for the Game of Life — patterns that, unlike the still-lifes and
oscillators in life's `*shapes*`, emit a glider every period FOREVER, so dropping
one onto a settled board re-energises it. Pure pattern GEOMETRY: cells as `[dx dy]`
from a top-left origin, plus reflections. Torus placement (`*w*`/`*h*`, `shift`)
and the stagnation logic that sows them stay in `life` (life/inject-shooter).")

;; The Gosper glider gun (36×9, period 30), as `[dx dy]` cells from its top-left
;; origin — the base pattern every shooter is built from.
(def *gosper-gun*
  [[0 4] [0 5]
    [1 4]
    [1 5]
    [10 4]
    [10 5]
    [10 6]
    [11 3]
    [11 7]
    [12 2]
    [12 8]
    [13 2]
    [13 8]
    [14 5]
    [15 3]
    [15 7]
    [16 4]
    [16 5]
    [16 6]
    [17 5]
    [20 2]
    [20 3]
    [20 4]
    [21 2]
    [21 3]
    [21 4]
    [22 1]
    [22 5]
    [24 0]
    [24 1]
    [24 5]
    [24 6]
    [34 2]
    [34 3]
    [35 2]
    [35 3]])

;; `pat` mirrored across its own vertical / horizontal mid-line. A reflection of a gun
;; is itself a valid gun (Life's rules are reflection-symmetric), so the one Gosper
;; definition yields more shooters — firing along different diagonals — for free.
(defn flip-x (pat)
  (let (mx (apply max (map (fn ([x y]) x) pat)))
    (map (fn ([x y]) [(- mx x) y]) pat)))
(defn flip-y (pat)
  (let (my (apply max (map (fn ([x y]) y) pat)))
    (map (fn ([x y]) [x (- my y)]) pat)))

;; The shooter set: the Gosper gun in all four reflections (each a working gun).
(def *shooters*
  [*gosper-gun* (flip-x *gosper-gun*)
    (flip-y *gosper-gun*)
    (flip-x (flip-y *gosper-gun*))])
