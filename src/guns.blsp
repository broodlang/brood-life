(defmodule guns
  "Glider GUNS for the Game of Life — patterns that, unlike the still-lifes and
oscillators in `shapes`, emit a glider every period FOREVER, so dropping one onto a
settled board re-energises it. A right click/drag in the app drops one of these. Pure
pattern GEOMETRY: cells as `[dx dy]` from a top-left origin. Torus placement (`*w*`/`*h*`)
and the schedule that sows them stay in `life` (life/inject-pattern)."
  (:use shapes))

(require 'shapes) ; the shared `orientations` generator (Life is isotropic, so do guns)
;; The Gosper glider gun (36×9, period 30), as `[dx dy]` cells from its top-left
;; origin — the one gun every shooter is an orientation of.
(defdyn *gosper-gun*
  [[0 4]
    [0 5]
    [1 4]
    [1 5]
    [10 4]
    [10 5]
    [10 6]
    [11 3]
    [11 7]
    [12 2]
    [12 8]
    [13 2]
    [13 8]
    [14 5]
    [15 3]
    [15 7]
    [16 4]
    [16 5]
    [16 6]
    [17 5]
    [20 2]
    [20 3]
    [20 4]
    [21 2]
    [21 3]
    [21 4]
    [22 1]
    [22 5]
    [24 0]
    [24 1]
    [24 5]
    [24 6]
    [34 2]
    [34 3]
    [35 2]
    [35 3]])

;; A rotation or reflection of a gun is itself a valid gun (Life's rules are isotropic),
;; so the one Gosper definition yields all eight shooters — firing along every diagonal —
;; for free. `orientations` (from `shapes`) dedupes the symmetric repeats.
(defdyn *shooters* (shapes/orientations *gosper-gun*))
