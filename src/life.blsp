(defmodule life
  "Conway's Game of Life on a wrapping torus, animated in a native GUI window. The board is
a packed BITBOARD (see `bitboard`) fit to the window. It starts EMPTY — LEFT click/drag
drops random shapes, RIGHT click/drag drops glider guns, holding either auto-repeats. The
SCROLL wheel is a VIEW zoom (a camera onto the mouse — the board is unchanged). Keys: `[`/`]`
cycle the auto-spawn preset; a bottom-right `clear` empties the board. Always runs UNCAPPED
(there is no frame-rate cap) and auto-spawns a random pattern every 30 s. Two processes
(ADR-058): a SIM that owns the board and paces
ITSELF with a self-resetting `(after)` timer that input preempts (so pastes are instant), and
this RENDERER that draws + handles input."
  (:use editor/display)
  (:use shapes)
  (:use guns))

;; The board API the rest of this file goes through. There was a second backend here — a
;; refc-shared BITSET twin behind `LIFE_BITSET=1`, whose `:bits` crossed send/table by an
;; Arc bump instead of deep-copying — and these were the dispatch layer between them. The
;; kernel's `bitset` type and its ops were removed from Brood on 2026-06-28, so that
;; backend could no longer run at all and is gone; the bignum `bitboard` is the only one.
;; They stay as named wrappers rather than being inlined at ~30 call sites: they are the
;; single seam if another backend is ever worth having.
(defn bb-make (w h) (bitboard/make w h))
(defn bb-place (b pat x y) (bitboard/place b pat x y))
(defn bb-step (b) (bitboard/step b))
(defn bb-live-count (b) (bitboard/live-count b))
(defn bb-fit (b w h) (bitboard/fit b w h))
(defn bb-refit (b w h) (bitboard/refit b w h))
;; Raw whole-board bit ops the colour layer + render run directly on `:bits`.
(defn bb-positions (b) (bit-positions b))
(defn bb-and (a b) (bit-and a b))
(defn bb-xor (a b) (bit-xor a b))

(defdyn *w* 120)
(defdyn *h* 40)
;; FAIR-COMPARISON OVERRIDE (env-driven, off by default). When `LIFE_BOARD=WxH` is set the
;; board is PINNED to those dims — `grid-fit`/`[:resize]` stop re-deriving `*w*`/`*h*` from the
;; window — and `LIFE_BLOCK=N` seeds a centred solid N×N block (and disables auto-inject), so
;; this port and the .NET one evolve cell-for-cell IDENTICALLY and only the engine speed differs.
(def *fixed-board* nil) ; [w h] when pinned via LIFE_BOARD, else nil (window-derived sizing)
;; Generations advanced per DRAWN frame (LIFE_STEPS, default 1). The renderer's present is
;; throttled to the monitor refresh (vsync), and the SIM waits for its `[:drawn]` ack, so at
;; 1 gen/frame the whole sim is pinned to ~refresh Hz no matter how fast the engine is. >1
;; runs the extra gens as bare steps between draws, so the simulation advances at engine speed
;; (gens/sec = steps-per-frame × drawn fps) while the display still paints once per refresh.
(def *steps-per-frame* 1)
;; FLAT render (LIFE_FLAT=1): always draw the board as ONE native `[:cells]` op in a single
;; colour, even when a spawn-colour layer exists — instead of the per-cell `[:text]` ops the
;; colour gradient needs. The experimental GPU backend (`gui-gpu`) only paints the bulk ops
;; (`[:cells]`/`[:rect]`), not `[:text]`, so this is what makes interactive play VISIBLE on the
;; GPU (at the cost of the per-cell colours). On the CPU backend it just renders flat-white.
(def *flat-render* false)
;; No frame-rate cap — the SIM always runs UNCAPPED (steps as fast as it can draw), bounded only
;; by the renderer's per-frame ack. `*step-rate*` is NOT a user cap: it's the internal rate at
;; which `sim-paste` folds a generation step in WHILE you drag (so a fast stroke isn't one step
;; per cell — see `step-due?`); the world otherwise advances every loop.
(def *step-rate* 120) ; gens/sec for drag-idle stepping (an anti-lag throttle, not a cap)
(def *board-height* 3) ; the FIXED window cell-font px (set once) — the board "canvas" cell SIZE.
;; Smaller ⇒ smaller blocks ⇒ MORE cells in the same window (a bigger X×Y board); larger ⇒
;; chunkier blocks, fewer cells. This is the knob for board "dimensions" — the window size
;; stays put. More cells is heavier to draw once they're live, so trade it against framerate.
;; A live cell is drawn as a SOLID CELL BACKGROUND (a space with *cell-face*'s `:bg`), not a
;; glyph — the kernel paints the bg as the whole cell rectangle, so neighbours TOUCH with no
;; font gaps. And each board cell spans *cell-aspect* screen columns so it comes out SQUARE
;; (a mono screen cell is ~1:2 wide:tall; 2 cols ≈ square). Raise/lower it if cells look
;; tall/wide. (So the board is `cols/*cell-aspect*` × `rows` cells.)
(def *cell-aspect* 2) ; screen columns per board cell (compensates the font's cell aspect)
(def *cell-face* {:bg :white}) ; a live cell: a solid filled square (the :bg is overridden per cell)
;; SPAWN COLOURS. Each spawn — a click/drag drop or an auto-inject — gets a fresh vivid colour,
;; and that colour is CARRIED ACROSS generations so you can see where a region came from: a
;; surviving cell keeps its colour, a newborn is the BLEND (channel average) of its live parents'
;; colours (the colour layer lives in `life`, parallel to the pure bitboard). Hue walks the wheel
;; by ~the golden angle per spawn, so consecutive spawns land far apart — a "big range" of
;; distinct colours — at fixed high saturation/value; where two colonies meet, the births between
;; them mix into gradients. An UNCOLOURED live cell (no parent carried a colour, or one kept
;; across a resize) falls back to *default-cell-bg*.
(def *default-cell-bg* :white) ; an uncoloured live cell — the original all-white look
(def *spawn-hue-step* 137) ; degrees of hue between consecutive spawn ids (≈ the golden angle)
(def *spawn-sat* 0.85) ; spawn-colour saturation (0–1): high ⇒ vivid, not washed out
(def *spawn-val* 0.95) ; spawn-colour value/brightness (0–1)
;; Scroll-wheel zoom is a VIEW (camera) zoom — purely for viewing. It does NOT change the
;; board: the torus keeps its full window resolution and ALL its cells (the off-screen ones
;; are still simulated). *view-zoom* magnifies a window of the board CENTRED ON THE MOUSE;
;; *view-ox*/*view-oy* are the top-left board cell of that window (the pan, kept in range).
;; At zoom 1 the whole board shows (pan 0,0). The window font/grid and the bar never change.
(def *view-zoom* 1) ; view magnification (1 = whole board; higher = zoomed in on the mouse)
(def *view-ox* 0) ; pan: leftmost visible board column
(def *view-oy* 0) ; pan: topmost visible board row
(def *zoom-min* 1)
(def *zoom-max* 10)
(def *zoom-step* 1)
;; The bottom status bar is a FIXED *status-scale* screen-cells tall at the FIXED window
;; font, so its pixel height is constant and zoom never touches it (the seamless win).
(def *status-scale* 4) ; the bar's height in (constant) screen cells / its glyph scale
(def *status-face* {:reverse true}) ; the bottom bar: reverse-video, like the brood-edit mode line
(def *grid-min* 5) ; the sim torus never shrinks below *grid-min* x *grid-min*
(def *seed-cells* 3000) ; target initial ACTIVE (live) cell count — `seed` sows random
; shapes until ~this many cells are live (the working population the sim paces against the cap).
; Capped to ~90% of the torus area so a board smaller than this can't loop forever.
;; A STATIONARY hold auto-repeats like a keyboard key: the press lands a shape AT ONCE,
;; then nothing for *hold-delay* gens (so a quick click stays a single drop), then a repeat
;; every *spawn-every* gens. Dragging is DRAWING — one shape per cell crossed — and does
;; NOT re-arm the delay, so when a drag stops the auto-repeat picks straight up at the
;; throttle rate; only a fresh press restarts the warm-up delay.
(def *hold-delay* 12) ; gens to hold before auto-repeat starts (~1.2 s at the 10 fps default)
(def *spawn-every* 6) ; gens between repeats once it's going (~1.7/s at the 10 fps default)
;; Auto-inject: drop a random pattern every *inject-secs* seconds to keep the board lively on
;; its own (0 = NEVER; you drive it). Starts at 30 s so an empty board comes to life on its own.
;; The spawn BUTTON cycles the presets off → 1s → 5s → 30s → off; the `[`/`]` keys step through
;; them (rarer / more often).
(def *inject-secs* 30) ; seconds between random auto-injects (0 = never)
(def *inject-presets* [1 5 30 0]) ; the auto-spawn options by frequency: 1 s, 5 s, 30 s, off
;; The REAPER (toggled by the footer button or the `r` key): a roving *reaper-size*² sprite that
;; steers for the OLDEST live cell and reaps whatever its footprint touches on the way — a
;; counter-weight to auto-spawn. Off by default; spawns at the TOP-LEFT corner. See `reaper-tick`.
(def *reaper-step-every* 1) ; gens between moves (1 = every gen; raise to slow its glide)
(def *reaper-size* 6) ; the reaper's edge in cells — its sprite AND its square reap footprint
(def *reaper-offsets*
  ; cell offsets from the anchor, roughly centred (size 6 ⇒ [-3 -2 -1 0 1 2])
  (into [] (map (fn (i) (- i (quot *reaper-size* 2))) (range *reaper-size*))))
(def *reaper-cloak* [95 8 24]) ; the robe — dark blood crimson, stands out over light/dark cells
(def *reaper-bone* [238 232 210]) ; the skull face
(def *reaper-scythe* [175 245 255]) ; the scythe (pole + blade)
;; The sprite: a *reaper-size*² grid, row-major (top→bottom, left→right), `nil` = transparent (not
;; drawn, though the reaper still reaps under it). A hooded figure — a bone skull up top, a crimson
;; cloak below split into legs, and a scythe pole down the right with its blade curving over the head.
;; Base sprite FACES RIGHT (scythe down the right column); `reaper-ops` mirrors it when heading left.
(def *reaper-sprite*
  (let (c *reaper-cloak* b *reaper-bone* s *reaper-scythe* x nil)
    [x
      s s s s x x b b x s x b b b b s x c c c c s x x c c x s x x c x c s x]))
(def *reaper-trail-life* 10) ; gens an ash-trail cell takes to fade out behind the reaper
(def *reaper-ash* [70 55 48]) ; the scorch colour at full strength (fades to black ⇒ invisible)
(def *reaper-flash* [255 255 255]) ; the one-frame bright burst on cells as they're reaped
(def *souls-label* "☠") ; the status-bar marker for the reaped-cell ("souls") counter
;; The bottom bar leads with two clickable BUTTONS — a SPAWN toggle and an FPS control
;; (click cycles a preset, drag scrubs). They're light raised KEYS overlaid on the reverse
;; bar, drawn *btn-inset* scale-steps SMALLER than the bar — so the bar shows as a margin
;; around AND a shelf below each key (spacing + a beveled, inset look). `footer-layout`
;; computes their cell columns + scale ONCE, and both the renderer and the click hit-test
;; use it. The RENDERER owns these values for instant labels and messages the SIM (both the
;; fps cap and the spawn interval) on every change.
(def *btn-inset* 1) ; how many scale-steps smaller the keys are than the bar (1 ⇒ a shelf below)
(def *btn-face* {:bg :white :fg :black :bold true}) ; a light raised KEY on the reverse bar
(def *clear-label* " clear ") ; the bottom-RIGHT key — click it to empty the board
(def *log-every* 30) ; the SIM writes a perf line to life.log every N gens (~0.3 Hz at the 10 fps default)
(def *log-path* "life.log") ; where the perf log is written (cwd; truncated each run)
;; Everything sowable mid-run: the still-lifes / oscillators / spaceships of `*shapes*`
;; plus the glider guns of `*shooters*` (both required above). `inject-pattern` samples
;; this uniformly, so any known shape can drop onto the board for variety, and a gun
;; lands often enough to keep re-energising a settling board.
(def *patterns* (append *shapes* *shooters*))

;; ---- the app icon: the iconic Life GLIDER, generated from the pattern itself ----------
;; A small RGBA tile handed to the kernel's `gui-icon!` at startup — the OS taskbar /
;; title-bar icon. The glider (Life's hacker emblem) is drawn bright on a dark tile, sized
;; from the pattern so the window always wears the app's own motif, not a baked-in image.
(def *icon-size* 32) ; the icon edge in px (a 32×32 RGBA tile)
(def *icon-glider* [[1 0] [2 1] [0 2] [1 2] [2 2]]) ; .X. / ..X / XXX — the emblem
(def *icon-bg* [16 18 28 255]) ; the tile: dark navy, opaque
(def *icon-fg* [70 230 150 255]) ; a live cell: bright green, opaque
(defn icon-rgba ()
  "The app icon as a flat row-major RGBA byte vector — *icon-size*² pixels, 4 bytes each
(red, green, blue, alpha). The 3×3 glider is scaled to *icon-size*/5 px cells and centred
(≈one cell of margin), bright green on dark — built straight from *icon-glider*."
  (let (n *icon-size*
        cell (quot n 5) ; 3 glider cells across ~3/5 of the tile, the rest a margin
        off (quot (- n (* 3 cell)) 2))
    ; centre the 3-cell glider in the tile
    (into []
      (mapcat (fn (py)
                (mapcat (fn (px)
                          (let (gx (quot (- px off) cell)
                                gy (quot (- py off) cell))
                            (if (and (>= px off)
                                  (>= py off)
                                  (< gx 3)
                                  (< gy 3)
                                  (includes? *icon-glider* [gx gy]))
                              *icon-fg*
                              *icon-bg*)))
                  (range n)))
        (range n)))))

;; The generation step is `bb-step` (one bit-plane neighbour sum over the packed
;; rows — cost independent of population); torus wrapping lives entirely in `bitboard`
;; (its row shifts wrap east/west, `place`/`refit` wrap or clip with `mod`/range checks).

(defn- seed-sow
  (s acc target)
  "Sow random shapes at random positions, threading the PRNG `s`, until the bitboard
`acc` holds at least `target` live cells; returns the board. Used by the test suite
(the live app starts empty — see `run-life`)."
  (if (>= (bb-live-count acc) target)
    acc
    (let ([shape s1] (sample s *shapes*)
          [x s2] (rand-int s1 *w*)
          [y s3] (rand-int s2 *h*))
      (seed-sow s3 (bb-place acc shape x y) target))))

(defn seed (s)
  "A random board: known shapes scattered across the torus until ~*seed-cells* cells
are live — capped to ~90% of the torus area (floored at 4) so a small board still seeds."
  (seed-sow s (bb-make *w* *h*) (max 4 (min *seed-cells* (floor (* 0.9 (* *w* *h*)))))))

;; Pattern GEOMETRY lives in the `shapes` / `guns` modules; placement is `life`'s job
;; (it needs the torus `*w*`/`*h*` and `bb-place`). The sim calls this on a schedule
;; both for visual variety and to revive a stagnant board (a gun lands eventually and
;; re-energises it).
(defn inject-pattern (live s)
  "Sow a random known pattern — any of `*patterns*` — at a random torus position onto
bitboard `live`, threading the PRNG `s`; returns `[live' s']`."
  (let ([pat s1] (sample s *patterns*)
        [x s2] (rand-int s1 (get live :w))
        [y s3] (rand-int s2 (get live :h)))
    [(bb-place live pat x y) s3]))

;; ---- the SPAWN-COLOUR layer (parallel to the pure bitboard) -------------------------------
;; `colors` maps a live cell's whole-board BIT INDEX `i` → its colour as ONE PACKED INTEGER (see
;; `pack-rgb` below). Keyed by the integer index (not an `[x y]` vector) because `recolor`
;; REBUILDS this map every frame and the colour layer — not the bitboard step — is the per-frame
;; hot spot: integer hashing is ~2× cheaper than hashing a 2-element vector key (measured). The
;; board width is baked into the index (`i` = `y*w + x`), so a resize rekeys the layer with
;; `colors-refit`. The bitboard stays pure (alive/dead only); the SIM threads this layer through
;; spawns and the step. A NEWBORN's colour is the BLEND (channel average) of its live parents'
;; colours, so where two colonies meet their colours mix — which is why the colour is stored per
;; cell, not as a spawn id (a blend names no one spawn). It's PACKED so that blend is one integer
;; add per parent rather than a per-channel vector fold (profiling: that fold was ~⅓ of the cost).

(defn hsv->rgb (h s v)
  "An HSV colour (`h` 0–360°, `s`/`v` 0–1) as an `[r g b]` byte vector (0–255) — the kernel
takes `[r g b]` for a face `:bg`. Standard sextant conversion; the sextant is `floor (h/60)`
and `f` its fraction (no float `mod`, which the kernel's `mod` doesn't take)."
  (let (hp (/ h 60.0)
        i (floor hp)
        f (- hp i)
        p (* v (- 1 s))
        q (* v (- 1 (* s f)))
        t (* v (- 1 (* s (- 1 f))))
        [r g b] (cond
                  (= i 0) [v t p]
                  (= i 1) [q v p]
                  (= i 2) [p v t]
                  (= i 3) [p q v]
                  (= i 4) [t p v]
                  else [v p q]))
    [(math/round (* 255 r)) (math/round (* 255 g)) (math/round (* 255 b))]))

(defn spawn-rgb (id)
  "The vivid `[r g b]` for spawn `id`: hue walks the wheel by *spawn-hue-step* per spawn, so
consecutive spawns are far apart on the colour wheel — a big range of distinct colours."
  (hsv->rgb (mod (* id *spawn-hue-step*) 360) *spawn-sat* *spawn-val*))

;; ---- PACKED colour storage (the per-frame hot-path representation) -------------------------
;; A cell's `[r g b]` is stored as ONE machine-word integer, because the per-frame cost is
;; `recolor`, and a newborn's colour is the sum of its live parents' colours: on a packed int that
;; is a single ADD per parent — no per-channel `vector-ref`, no 8-wide accumulator vector (which
;; profiling showed was ~⅓ of the blend cost). Each channel sits in its own 12-bit field so the
;; sums don't carry into each other, and a CELL COUNT rides in the bits above: bits 0-11 = r,
;; 12-23 = g, 24-35 = b, 36+ = count (1 per stored colour). A channel is 0-255, so summing the ≤8
;; neighbours of a cell stays < 4096 and never overflows its field; the count of those neighbours
;; then falls out as `value >> 36`. Values stay well under 2^40 (never a bignum). The kernel wants
;; an `[r g b]` for a face `:bg`, so `cell-bg` unpacks at draw time.
(def *rgb-count* (bit-shift-left 1 36)) ; the "one cell" unit summed in the high bits
(def *rgb-mask* 4095) ; 2^12 - 1: isolates one channel's 12-bit field
(defn pack-rgb ([r g b])
  "Pack an `[r g b]` (channels 0-255) into the single integer the colour layer stores — bits 0-11
r, 12-23 g, 24-35 b, plus one count unit in bits 36+ (see the packed-colour scheme above)."
  (+ r (bit-shift-left g 12) (bit-shift-left b 24) *rgb-count*))

(defn unpack-rgb (p)
  "The `[r g b]` of packed colour `p` — the inverse of `pack-rgb`; the high-bit count is dropped
(a stored colour always counts one cell)."
  [(bit-and p *rgb-mask*)
    (bit-and (bit-shift-right p 12) *rgb-mask*)
    (bit-and (bit-shift-right p 24) *rgb-mask*)])

(defn color-spawn (colors next-id old-bits new-bits)
  "Give every cell the latest placement turned on (bits in `new` not in `old`) the next spawn's
fresh colour, so each spawn is its own colour. Returns `[colors' next-id']`. A placement only
OR-s bits in, so `new ⊇ old` and the added cells are exactly `new XOR old` — `bit-positions`
hands them back as the bit INDICES the colour layer keys on, so no decode is needed here."
  (let (added (bb-positions (bb-xor new-bits old-bits)))
    (if (nil? added)
      [colors next-id]
      (let (packed (pack-rgb (spawn-rgb next-id)))
        ; one colour for the whole spawn — compute + pack it once
        [(reduce (fn (c i) (assoc c i packed)) colors added) (+ next-id 1)]))))

(defn birth-blend (colors w h i)
  "The PACKED colour a NEWBORN at bit index `i` takes: the BLEND (channel average) of its parents'
colours — its 8 torus neighbours that carry one. A stored colour means the neighbour was live last
gen, so this is exactly the live parents (a birth has 3); `nil` if none is coloured. Summing the
eight neighbour words (absent ⇒ 0) accumulates the parents' three channel fields AND their count
(bits 36+) in ONE integer — one add per parent, no accumulator vector (see the packed-colour
scheme above; this runs once per birth and births are the per-frame hot spot — see `recolor`).
The eight neighbour bit indices come from three row bases and two wrapped columns, so the torus
wrap costs five `mod`s, not sixteen."
  (let (x (mod i w)
        y (quot i w)
        rn (* (mod (+ y -1) h) w) ; bit-index base of the row above (torus-wrapped)
        rc (* y w) ; this row
        rs (* (mod (+ y 1) h) w) ; the row below
        cl (mod (+ x -1) w) ; column to the left (wrapped)
        cr (mod (+ x 1) w) ; column to the right (wrapped)
        acc (+ (or (get colors (+ rn cl)) 0)
              (or (get colors (+ rn x)) 0)
              (or (get colors (+ rn cr)) 0)
              (or (get colors (+ rc cl)) 0)
              (or (get colors (+ rc cr)) 0)
              (or (get colors (+ rs cl)) 0)
              (or (get colors (+ rs x)) 0)
              (or (get colors (+ rs cr)) 0))
        n (bit-shift-right acc 36))
    ; how many neighbours carried a colour
    (if (= n 0)
      nil
      ;; `acc`'s three 12-bit fields are the summed channels (the high count drops out under the
      ;; same masks `unpack-rgb` uses), so average each over the parent count and re-pack.
      (let ([sr sg sb] (unpack-rgb acc))
        (+ (quot sr n)
          (bit-shift-left (quot sg n) 12)
          (bit-shift-left (quot sb n) 24)
          *rgb-count*)))))

(defn recolor (colors old-bits new-bits w h)
  "Carry the colour layer across ONE generation. INCREMENTALLY: a SURVIVOR (live both gens) keeps
its packed colour in place, so only the CHANGED cells touch the map — drop the DEAD (`old & ~new`)
and blend the NEWBORN (`new & ~old`). `birth-blend` reads the ORIGINAL `colors`, since the dead
cells were live LAST gen and so are valid parents. A full rebuild re-asserted every survivor (~half
the live cells) into a fresh map for nothing; writing only the churn (deaths + births, a fraction
of the population) measured ~10% faster. (The one behavioural difference from a rebuild — a
COLOURLESS live cell stays colourless rather than being blended — can't arise in play: every cell
descends from a coloured spawn, so colour reaches everywhere. Verified identical to a rebuild over
150 generations of spawns.)"
  (let (surv (bb-and old-bits new-bits)
        born (bb-positions (bb-xor new-bits surv)) ; new & ~old — the births this gen
        dead (bb-positions (bb-xor old-bits surv)) ; old & ~new — the deaths this gen
        live-colors (reduce (fn (c i) (dissoc c i)) colors dead))
    (reduce
      (fn (c i)
        ;; only store a colour when the birth actually has a coloured parent — a
        ;; colourless cell stays ABSENT (not a nil entry), so an all-uncoloured board
        ;; keeps `colors` empty and the native `[:cells]` fast path in `render` fires.
        (let (b (birth-blend colors w h i))
          (if (nil? b) c (assoc c i b))))
      live-colors
      born)))

(defn colors-refit (colors old-w new-w new-h)
  "Rekey the colour layer from board width `old-w` to a `new-w`×`new-h` board, DROPPING cells
that fall outside the new bounds — the colour-layer twin of `bb-refit` (the keys are bit
indices, so the width is baked in). Run on a resize so a survivor keeps its colour at its new
index. A no-op caller-side when the width is unchanged. The packed colour value is opaque here —
only its key (the bit index) changes with the width."
  (reduce (fn (acc [i packed])
            (let (x (mod i old-w) y (quot i old-w))
              (if (and (< x new-w) (< y new-h)) (assoc acc (+ (* y new-w) x) packed) acc)))
    {}
    colors))

;; ---- the REAPER's pure core. While it's on the SIM keeps a parallel AGE layer (`ages`: bit index
;; → the generation a cell was born) carried across each step exactly like the colour layer — a
;; survivor keeps its birth-gen, a newborn is stamped NOW, a death is dropped — so the OLDEST live
;; cell is simply the smallest stored value. The age/reap math is whole-board-integer specific,
;; which the bignum bitboard is.
(defn age-step (ages old-bits new-bits gen)
  "Carry the cell-AGE layer across one generation — the age analogue of `recolor`: drop the dead
(`old & ~new`), stamp each newborn (`new & ~old`) with `gen`, survivors keep their birth-gen.
Pass the PRE-spawn board as `old-bits` so a cell spawned this gen lands in `new & ~old` and is
stamped here — a survivor with no age would otherwise stay ageless and invisible to the reaper."
  (let (both (bit-and old-bits new-bits)
        dead (bit-positions (bit-xor old-bits both))
        born (bit-positions (bit-xor new-bits both))
        a1 (reduce (fn (a i) (dissoc a i)) ages dead))
    (reduce (fn (a i) (assoc a i gen)) a1 born)))

(defn oldest-xy (ages w rx ry)
  "The `[x y]` of the OLDEST live cell — smallest birth-gen — with ties broken by NEAREST to the
reaper `(rx,ry)` (Chebyshev distance), then lowest bit index. Breaking ties by distance keeps the
pick STABLE as the reaper moves, so on a repick it continues to a near cell instead of jumping
across the board. nil when the layer is empty. Linear in the population."
  (let (best (reduce (fn (acc [i g])
                       (let (d (max (math/abs (- (mod i w) rx)) (math/abs (- (quot i w) ry))))
                         (if (or (nil? acc)
                               (< g (vector-ref acc 1))
                               (and (= g (vector-ref acc 1)) (< d (vector-ref acc 2))))
                           [i g d]
                           acc)))
               nil ages))
    (if (nil? best) nil [(mod (vector-ref best 0) w) (quot (vector-ref best 0) w)])))

(defn footprint (cx cy w h)
  "The whole-board bit indices of the reaper's *reaper-size*² block centred on `(cx,cy)`, torus-
wrapped (its reap area)."
  (mapcat (fn (dy) (map (fn (dx) (+ (mod (+ cx dx) w) (* (mod (+ cy dy) h) w))) *reaper-offsets*))
    *reaper-offsets*))

(defn clear-cells (board idxs)
  "Clear the live cells at bit indices `idxs` (the robot's footprint) from `board`: build the mask
of those CURRENTLY live and XOR it out, so only set bits flip. Whole-board-integer specific."
  (let (bits (get board :bits)
        m (reduce (fn (msk i)
                    (let (bit (bit-shift-left 1 i))
                      (if (= 0 (bit-and bits bit)) msk (bit-or msk bit))))
            0 idxs))
    (assoc board :bits (bit-xor bits m))))

(defn toward (a b)
  "One step of `a` toward `b`: +1, -1, or 0 when already there."
  (cond (< a b) 1 (> a b) -1 else 0))

(defn reaper-tick (rp board ages colors)
  "Advance the reaper ONE generation. `rp` is `{:rx :ry :tx :ty :move :face :trail :flash}`. It
COMMITS to a target — the nearest of the oldest live cells — and marches there DECISIVELY, reaping
its footprint (board + age + colour layers) each move; it repicks ONLY on ARRIVAL (or when nothing
is left). Committing to the heading until it arrives — rather than dropping the target the moment
that cell dies in the churn — is what stops it dithering. `toward` shrinks the distance every move,
so arrival is guaranteed. Also tracks `:face` (heading, for the sprite), `:trail` (the fading ash
wake: cell → remaining gens), and `:flash` (the cells reaped THIS tick — the burst + souls tally).
Returns `[board' ages' colors' rp']`."
  (let (w (get board :w)
        h (get board :h)
        rx0 (get rp :rx)
        ry0 (get rp :ry)
        ;; hold the committed heading; only pick (nearest-oldest) when we have none
        tgt (if (get rp :tx) [(get rp :tx) (get rp :ty)] (oldest-xy ages w rx0 ry0))
        move? (>= (get rp :move) (- *reaper-step-every* 1))
        ;; step one cell toward the target on a move tick (hold still with no target)
        rx (if (and move? tgt) (+ rx0 (toward rx0 (first tgt))) rx0)
        ry (if (and move? tgt) (+ ry0 (toward ry0 (second tgt))) ry0)
        idxs (footprint rx ry w h)
        ;; the cells actually reaped THIS tick = the LIVE ones under the footprint (flash + souls)
        reaped (filter (fn (i) (not (= 0 (bit-and (get board :bits) (bit-shift-left 1 i))))) idxs)
        ages2 (reduce (fn (a i) (dissoc a i)) ages idxs)
        colors2 (reduce (fn (c i) (dissoc c i)) colors idxs)
        ;; ash wake: age every scorch one step + drop the spent, then scorch the whole new footprint
        trail1 (reduce (fn (t [c r]) (if (> r 1) (assoc t c (- r 1)) t)) {} (get rp :trail))
        trail2 (reduce (fn (t i) (assoc t i *reaper-trail-life*)) trail1 idxs)
        ;; facing follows the horizontal step; keep the last facing on a purely vertical move
        face (let (sdx (- rx rx0)) (cond (> sdx 0) 1 (< sdx 0) -1 else (or (get rp :face) 1)))
        ;; stay committed until we reach the target's cell; only then repick the next nearest-oldest
        arrived? (and tgt (= rx (first tgt)) (= ry (second tgt)))
        nt (if (and tgt (not arrived?)) tgt (oldest-xy ages2 w rx ry)))
    [(clear-cells board reaped)
      ages2
      colors2
      (assoc rp
        :rx rx
        :ry ry
        :tx (if nt (first nt) nil)
        :ty (if nt (second nt) nil)
        :move (if move? 0 (+ (get rp :move) 1))
        :face face
        :trail trail2
        :flash reaped)]))

;; The two CLICKABLE button labels — fixed width (11 + 9 chars) so the layout/hit ranges
;; stay put as the numbers change; `pad-left` holds the value column. They take the value to
;; show (the renderer's LOCAL copy) rather than reading a global, so the renderer can repaint
;; them the instant you click/drag, ahead of the sim.
(defn spawn-label (inject)
  (str " spawn " (if (> inject 0) (str (string/pad-left (str inject) 2) "s") "off") " "))

(defn reaper-label (on)
  "The `[reaper]` key — fixed width (12 chars) so the layout/hit ranges hold as the state flips."
  (str " reaper " (string/pad-left (if on "on" "off") 3) " "))

;; The footer's CELL layout at the current scale, the single source of truth for both the
;; renderer and the click hit-test. The keys are *btn-inset* steps smaller than the bar, so
;; each char is `bs` cells; `m`-cell bar margins sit around/between them; `voff` drops the
;; (shorter) key to sit in the bar with a shelf below; `info-char` is where the full-scale
;; info text starts, clear of the keys (in bar-chars, ceil'd).
(defn footer-layout (vcols)
  "Cell layout of the footer's keys for the renderer + hit-test. `vcols` is the bar's screen
width, so the CLEAR key can sit at the bottom-RIGHT (the spawn/fps keys lead at the left)."
  (let (bs (max 1 (- *status-scale* *btn-inset*))
        m bs
        sw (* (string/length (spawn-label 0)) bs)
        rw (* (string/length (reaper-label false)) bs)
        cw (* (string/length *clear-label*) bs)
        sx0 m
        sx1 (+ sx0 sw)
        rx0 (+ sx1 m) ; the reaper key sits just right of spawn, an `m` margin between
        rx1 (+ rx0 rw)
        infocell (+ rx1 m m)
        cx1 (max rx1 (- vcols m)) ; clear key: right-aligned, an `m` margin off the edge
        cx0 (- cx1 cw))
    {:bs bs
     :voff (quot (- *status-scale* bs) 2)
     :spawn [sx0 sx1]
     :reaper [rx0 rx1]
     :clear [cx0 cx1]
     :info-char (quot (+ infocell (- *status-scale* 1)) *status-scale*)}))

;; The INFO half of the bar (gen / measured fps / live cells / memory). The two buttons are
;; prepended by the renderer (`footer-ops`), not here. (No GC field: `gc-stats` is dev-only.)
(defn status (gen cells per souls)
  "The info fields of the bottom strip from one generation's measurement (`per` = ns since
the previous frame). The renderer composes this after the buttons. Each number is padded to a
FIXED width so the line never reflows as digit counts change (the bar is a monospace grid).
`souls` is the reaper's lifetime reaped-cell tally."
  (str "gen "
    (string/pad-left (str gen) 7)
    " · "
    (string/pad-left (str (quot 1000 (max 1 (quot per 1000000)))) 4)
    " fps · "
    (string/pad-left (str cells) 6)
    " cells · "
    *souls-label*
    " "
    (string/pad-left (str souls) 7)
    " · "
    (string/pad-left (str (quot (mem-bytes) 1048576)) 4)
    " MB"))

;; The bottom bar as render ops: a full-width reverse `bar` holding the INFO (shifted past
;; the keys so it can't underlap), then the two SMALLER keys OVERLAID in *btn-face* at the
;; cell columns `footer-layout` computes, dropped by `voff` so the bar shows as a shelf below
;; them. `top`/`vcols` come from the board being drawn (`render`), so the bar is always
;; positioned consistently with the board — no resize jump.
(defn footer-ops (ui info top vcols)
  (let (l (footer-layout vcols)
        bs (get l :bs)
        face (assoc *btn-face* :scale bs)
        [sx0 _] (get l :spawn)
        [rx0 _] (get l :reaper)
        [cx0 _] (get l :clear)
        brow (+ top (get l :voff))
        bg (bar top
             vcols
             (str (string/repeat " " (get l :info-char)) info)
             {:face *status-face* :align :left :scale *status-scale*}))
    [bg
      [:text brow sx0 (spawn-label (get ui :inject)) face]
      [:text brow rx0 (reaper-label (get ui :reaper-on)) face]
      [:text brow cx0 *clear-label* face]]))

;; The leading `clear` wipes the previous frame, so we paint only what's lit. ALL geometry
;; comes from `live` itself (`:h`/`:w`), so the board and the bar below it (at row `:h`) are
;; sized from ONE snapshot — the brood-edit anti-jitter rule: never composite a stale board
;; under a freshly-measured bar position (that mismatch made the footer jump on resize).
;; *view-zoom* is a render-only camera (per-op `:scale`, ADR-079) over the SAME board, so
;; zooming changes neither the board nor the bar — only which window of cells is magnified.
(defn cell-bg (colors i)
  "The `:bg` for the live board cell with whole-board bit index `i`: its `[r g b]` colour
(unpacked from the stored packed integer), or *default-cell-bg* for an uncoloured cell (no parent
carried a colour, or one kept past a resize)."
  (let (p (get colors i))
    (if (nil? p) *default-cell-bg* (unpack-rgb p))))

;; ---- the reaper's on-canvas overlay: a fading ash trail (bottom), a one-frame reap flash, and the
;; facing sprite (top). All three magnify z× and clip/torus-wrap to the visible window the same way
;; the zoomed cell loop does — `overlay-cell` is the shared per-cell op builder.
(defn overlay-cell (bx by col w h z a ox oy visw vish)
  "One overlay op for board cell `(bx,by)` filled with colour `col`, mapped through the view (pan
`ox`/`oy`, zoom `z`) and torus-wrapped — a 1-element list, or [] when the cell is off-screen."
  (let (sx (- (mod bx w) ox)
        sy (- (mod by h) oy))
    (if (and (>= sx 0) (< sx visw) (>= sy 0) (< sy vish))
      [[:text (* sy z) (* sx (* a z)) (string/repeat " " a) (assoc *cell-face* :bg col :scale z)]]
      [])))

(defn trail-ops (rv w h z a ox oy visw vish)
  "The fading ash wake: each trail cell (`*reaper-ash*` scaled by its remaining life) drawn behind
the reaper, dimming to black as it ages out."
  (let (life *reaper-trail-life*)
    (mapcat (fn ([i r])
              (overlay-cell (mod i w)
                (quot i w)
                (into [] (map (fn (c) (quot (* c r) life)) *reaper-ash*))
                w
                h
                z
                a
                ox
                oy
                visw
                vish))
      (get rv :trail))))

(defn flash-ops (rv w h z a ox oy visw vish)
  "The one-frame reap burst: the cells reaped this tick, lit bright (`*reaper-flash*`)."
  (mapcat (fn (i) (overlay-cell (mod i w) (quot i w) *reaper-flash* w h z a ox oy visw vish))
    (get rv :flash)))

(defn reaper-ops (rv w h z a ox oy visw vish)
  "The reaper's facing sprite — the hooded figure (`*reaper-sprite*`), MIRRORED when `:face` is -1
so the scythe leads the way it's heading. Skips transparent (nil) sprite cells."
  (let (rx (get rv :x)
        ry (get rv :y)
        face (or (get rv :face) 1)
        n *reaper-size*)
    (mapcat
      (fn ([ix iy])
        (let (src (if (< face 0) (- (- n 1) ix) ix) ; mirror columns when facing left
              col (vector-ref *reaper-sprite* (+ (* iy n) src)))
          (if (nil? col)
            []
            (overlay-cell (+ rx (vector-ref *reaper-offsets* ix))
              (+ ry (vector-ref *reaper-offsets* iy))
              col
              w
              h
              z
              a
              ox
              oy
              visw
              vish))))
      (mapcat (fn (iy) (map (fn (ix) [ix iy]) (range n))) (range n)))))

(defn reaper-overlay-ops (rv w h z a ox oy visw vish)
  "All reaper overlay ops, bottom→top: fading ash trail, the reap flash, then the facing sprite —
or [] when the reaper is off (`rv` is the render bundle from `reaper-view`, or nil)."
  (if (nil? rv)
    []
    (append (trail-ops rv w h z a ox oy visw vish)
      (flash-ops rv w h z a ox oy visw vish)
      (reaper-ops rv w h z a ox oy visw vish))))

(defn render (live ui info)
  "A display frame from `live`: the live cells as `:text` ops, then the bottom bar at row
`*h*`. At *view-zoom* 1 (the whole board) it's ONE `bit-positions` over the whole-board
integer — bit `i` is cell `(i mod w, i div w)`, decoded INLINE here (no `bit->xy` tuple per
cell) — so the hot loop is a single enumeration with no per-row scan. Zoomed in, only the
visible board WINDOW (`*view-ox*`/`*oy*`, `w/z × h/z` cells) is drawn, magnified z×: each
row's window is shifted to the origin and masked to the column range (still O(visible-live),
and fewer cells show), each at `px*z`. The cell ops and the footer are spliced with one lazy
`append` poured into a SINGLE vector (`into`), so the O(live) ops vector is built once, not
copied again to append the bar."
  (let (z *view-zoom*
        a *cell-aspect*
        fill (string/repeat " " a) ; an `a`-wide blank; the face's bg fills its cell box
        colors (get ui :colors) ; the spawn-colour layer: bit index → packed colour
        rv (get ui :reaper) ; the reaper's render bundle (pos/face/trail/flash), or nil when off
        bits (get live :bits)
        h (get live :h)
        wdt (get live :w))
    (into [(clear)]
      (append
        (if (= z 1)
          ;; Blit the WHOLE board as ONE native op — the kernel enumerates set bits and fills
          ;; each cell (O(live), in Rust) — instead of one interpreted `[:text]` op per cell
          ;; (which was ~110 ms / 10K cells). Uncoloured (or flat): a single-colour `[:cells]`.
          ;; Coloured: `[:cells-rgb]`, each cell taking its spawn colour from the `colors` map.
          ;; whole-board fast path (one native op), then the reaper sprite over it (ox=oy=0, z=1).
          (append (if (or *flat-render* (= 0 (count colors)))
                    [[:cells 0 0 wdt a bits *default-cell-bg*]]
                    [[:cells-rgb 0 0 wdt a bits colors *default-cell-bg*]])
            (reaper-overlay-ops rv wdt h 1 a 0 0 wdt h))
          (let (visw (max 1 (quot wdt z))
                vish (max 1 (quot h z))
                ox (max 0 (min *view-ox* (max 0 (- wdt visw))))
                oy (max 0 (min *view-oy* (max 0 (- h vish))))
                vismask (- (bit-shift-left 1 visw) 1)
                zface (assoc *cell-face* :scale z)
                az (* a z))
            ;; the magnified visible window, then the robot block over it (mapped through the
            ;; same pan/zoom transform).
            (append
              (mapcat
                (fn (sy)
                  ;; the visible window of row (oy+sy): shift it to bit 0, mask to visw
                  (let (row-base (* (+ oy sy) wdt) ; whole-board bit index of (ox, oy+sy)
                        vr (bit-and (bit-shift-right bits (+ row-base ox)) vismask))
                    (if (= vr 0)
                      nil
                      (map
                        (fn (px)
                          [:text
                            (* sy z)
                            (* px az)
                            fill
                            ;; the visible cell's whole-board bit index = row-base + (ox+px)
                            (assoc zface :bg (cell-bg colors (+ row-base ox px)))])
                        (bit-positions vr)))))
                (range vish))
              (reaper-overlay-ops rv wdt h z a ox oy visw vish))))
        ;; the bar spans the full SCREEN width (board cols × *cell-aspect*), at screen row *h*.
        (footer-ops ui info h (* wdt a))))))

;; ---- the actors: SIM (board + log, self-paced) → RENDERER (compositor) --------
;; The SIM owns the board and paces itself with a self-resetting `(after)` timer; the RENDERER
;; (root) owns the window and composites. (ADR-058 concurrency.)

(defn log-fmt (gen cells per)
  "A compact, tab-separated perf line for the debug log — one column per field, so it
greps/plots cleanly (`cells` and `fps` are the headline; `ms`/gen and `mb` tie a frame-rate
dip to rising population or memory churn)."
  (str "gen "
    gen
    "\tcells "
    cells
    "\tfps "
    (quot 1000 (max 1 (quot per 1000000)))
    "\tms "
    (quot per 1000000)
    "\tmb "
    (quot (mem-bytes) 1048576)))

;; The SIM owns the board and paces ITSELF: its `receive` parks on an `(after period)` timeout
;; — a self-resetting timer (the same mechanism as ADR-101's named `ui-run` timers: both are
;; just a `receive` parked on a computed deadline). Any input message PREEMPTS that timeout, so
;; a paste is applied + drawn AT ONCE, never blocked behind the cap — ADR-058's instant-paste
;; invariant, now with one fewer process (the old CLOCK and its [:tick]/[:ticked] handshake are
;; gone). The RENDERER owns the window + input.

(defn reaper-view (on rp)
  "The reaper RENDER BUNDLE `render` needs — position, facing, ash trail, and reap flash — or nil
when off. What `sim-draw` hands `render` so the reaper (and its trail/flash) rides along in the
SIM's pre-built ops. `on` is the reaper-on flag, `rp` the reaper state."
  (if (and on rp)
    {:x (get rp :rx)
     :y (get rp :ry)
     :face (get rp :face)
     :trail (get rp :trail)
     :flash (get rp :flash)}
    nil))

(defn sim-draw (m board st colors reaper)
  "Build this frame's render OPS here (on the SIM — a spawned process, ~2× faster at compute than
the root renderer) and send them with the board + status `st` + colour layer; the renderer just
BLITS the ops (no per-frame render on the slow root), while keeping board/colours to re-render
locally on input. Sending the ops costs ~one colour-map copy more, far less than the render it
moves off the root. Wait for the `[:drawn]` ack (bounds the renderer's mailbox to one frame).
`reaper` is its render bundle from `reaper-view` (nil when off). Returns `:ok`, or `:stop` if torn
down while waiting."
  (let (ops (render board {:colors colors :inject (get m :inject) :reaper reaper} st)
        ;; Send the renderer a SLIM board — NOT the full record. The torus masks
        ;; (`:board`/`:col0`/`:high`, each a whole-grid-sized bignum) are only used by `step`,
        ;; on the SIM; copying them across the process boundary every frame was the dominant
        ;; per-frame cost (O(board bits) — it pinned a 512² board to ~16 fps even empty).
        ;; In the uncoloured fast path the live `:bits` already ride along inside the `[:cells]`
        ;; op, so we OMIT them here too and the renderer recovers them from the op (`cells-bits`)
        ;; — one fewer whole-board copy per frame. With a colour layer the ops are per-cell
        ;; `[:text]` with no single bitboard, so `:bits` stay on the slim board.
        slim (if (= 0 (count colors))
               {:w (get board :w) :h (get board :h)}
               {:w (get board :w) :h (get board :h) :bits (get board :bits)}))
    (do
      (send (get m :renderer) [:board slim st colors ops])
      (receive ([:drawn] :ok) (:stop :stop) (after 2000 :ok)))))

(defn apply-clicks (board clicks s)
  "Drop a random pattern at each click cell `[x y kind]`, threading the PRNG `s`: a `:gun`
cell samples a glider gun (`*shooters*`, right button), any other kind samples a shape
(`*shapes*`, left button). Returns `[board' s']` — the only way cells enter the board
(the app starts empty)."
  (reduce (fn ([b s] [x y kind])
            (let (catalog (if (= kind :gun) *shooters* *shapes*)
                  [pat s1] (sample s catalog))
              [(bb-place b pat x y) s1]))
    [board s]
    clicks))

;; The SIM threads ONE state map `m` (see `run-life` for its keys) — board, PRNG `s`, `gen`,
;; the last-step time `prev`, the `held` cell + its age `hn`, the `inject` interval + its last
;; fire `last-inj`, the cached status `st`, the fps `cap`, plus the never-changing `renderer`
;; and `logger`. Every loop function takes `m` and recurses with just the keys it changed.
(defn sim-step (m)
  "Advance ONE generation (the self-paced `(after)` timer fired): fit to the window
(`*w*`/`*h*`, set by the renderer), fold in the held-cell auto-repeat + the wall-clock
auto-inject, step, DRAW it, and recurse. No clock to ack — the SIM paces itself. The held-cell
repeat fires every *spawn-every* gens past *hold-delay* (the initial press/drag already drew)."
  (let (sp *steps-per-frame*
        ;; Turbo: advance (sp-1) EXTRA bare generations before the drawn one, so the sim runs
        ;; at engine speed instead of being pinned to the renderer's vsync rate. The extra gens
        ;; are plain board steps (no inject/held/colour) — for the uncoloured throughput bench;
        ;; at the default sp=1 this is a no-op (an empty `reduce`).
        ob (reduce (fn (b _) (bb-step b)) (bb-fit (get m :board) *w* *h*) (range (- sp 1)))
        board (bb-fit ob *w* *h*)
        w (get board :w)
        h (get board :h)
        ;; a window resize changed *w*/*h*: the colour keys are bit indices, so rekey the layer
        ;; to the new width (drops off-board cells) — mirrors the board's `bb-fit` above.
        colors0 (if (= (get ob :w) w)
                  (get m :colors)
                  (colors-refit (get m :colors) (get ob :w) w h))
        now (now-ns)
        per (- now (get m :prev))
        held (get m :held)
        hn2 (if held (+ (get m :hn) 1) 0)
        repeat? (and held (>= hn2 *hold-delay*) (= 0 (mod (- hn2 *hold-delay*) *spawn-every*)))
        [b1 s1] (if repeat? (apply-clicks board [held] (get m :s)) [board (get m :s)])
        ;; colour each spawn (held-repeat, then auto-inject) as it lands, then carry the layer
        ;; across the step — survivors keep their colour, newborns blend their live parents'.
        [c1 n1] (if repeat?
                  (color-spawn colors0 (get m :next-id) (get board :bits) (get b1 :bits))
                  [colors0 (get m :next-id)])
        inject (get m :inject)
        inj? (and (> inject 0) (>= (- now (get m :last-inj)) (* inject 1000000000)))
        [b2 s2] (if inj? (inject-pattern b1 s1) [b1 s1])
        [c2 n2] (if inj? (color-spawn c1 n1 (get b1 :bits) (get b2 :bits)) [c1 n1])
        last-inj2 (if inj? now (get m :last-inj))
        nxt (bb-step b2)
        ;; Skip the per-birth colour blend entirely when no spawn colour is in play:
        ;; with `c2` empty every birth blends to nil and every death dissocs nothing, so
        ;; recolor is guaranteed to return the empty map — pure wasted work (the per-birth
        ;; `birth-blend` over the churn is the frame's biggest remaining cost). An
        ;; uncoloured board (the fair benchmark, a fresh board) now pays nothing here.
        c3 (if (= 0 (count c2)) c2 (recolor c2 (get b2 :bits) (get nxt :bits) w h))
        gen (+ (get m :gen) (- sp 1)) ; the (sp-1) bare steps already advanced the generation
        ;; the reaper (only when toggled on): rekey the age layer across any resize (same bit-index
        ;; remap as the colour layer), carry it across the step, then move + reap its footprint —
        ;; `reaper-tick` returns the board, the age + colour layers, and the reaper's state.
        ;; age-step's OLD bits are the PRE-spawn board, not `b2`: a cell spawned this gen (in `b2`
        ;; but not `board`) that then SURVIVES the step would otherwise count as a survivor and
        ;; keep an age it never had — leaving a live, ageless cell the reaper can't see. Folding it
        ;; into `born` instead stamps it "born now", the age analogue of `color-spawn`.
        reaping? (get m :reaper-on)
        ages0 (if (and reaping? (not (= (get ob :w) w)))
                (colors-refit (get m :ages) (get ob :w) w h)
                (get m :ages))
        ages1 (if reaping? (age-step ages0 (get board :bits) (get nxt :bits) gen) ages0)
        [fboard fages fcolors frp] (if reaping?
                                     (reaper-tick (get m :reaper) nxt ages1 c3)
                                     [nxt ages1 c3 (get m :reaper)])
        souls2 (+ (get m :souls) (if reaping? (count (get frp :flash)) 0)) ; lifetime reaped tally
        cells (bb-live-count fboard)
        st2 (status gen cells per souls2))
    (do
      (when (< (mod gen *log-every*) sp) (perflog/log-line (get m :logger) (log-fmt gen cells per)))
      (if (= :stop (sim-draw m fboard st2 fcolors (reaper-view reaping? frp)))
        (perflog/log-stop (get m :logger))
        (sim-loop (assoc m
                    :board fboard
                    :s s2
                    :gen (+ gen 1)
                    :prev now
                    :hn hn2
                    :last-inj last-inj2
                    :st st2
                    :colors fcolors
                    :ages fages
                    :reaper frp
                    :souls souls2
                    :next-id n2))))))

(defn step-due? (prev)
  "Is a generation step OVERDUE — has a full *step-rate* period elapsed since the last step
(`prev`)? `sim-paste` consults this at its DRAIN-IDLE point to decide whether to fold a step in
(vs. handing back to the loop) WHILE you drag, so the world animates as you draw without
stepping once per pasted cell — a step costs far more than a paste, so that would lag the
stroke. (Not a frame-rate cap: the paced loop itself runs uncapped.)"
  (>= (- (now-ns) prev) (* (quot 1000 *step-rate*) 1000000)))

(defn sim-paste (m kind x y newhn)
  "Apply ONE pasted pattern; if more paste events are ALREADY queued (a fast drag), apply
those too BEFORE redrawing — so a burst is ONE O(live) redraw, not one per cell crossed (the
fix for spawning tanking the fps). When the queue drains (`after 0` — the mailbox is now
provably empty), draw the stroke, then fold in a generation step IF one is due (`step-due?`):
doing it HERE, not back in `sim-loop`, is the fix for the world freezing while you draw — a
fresh `[:drag]` arriving in `sim-loop` would preempt its `(after wait)` and starve the step,
but here the queue is already clear. Not due yet ⇒ just draw and hand back to the paced loop.
`newhn` is the held-cell age to carry once the burst settles (0 on a fresh press, kept on a
drag); the just-pasted cell becomes `:held`."
  (let ([b2 s2] (apply-clicks (get m :board) [[x y kind]] (get m :s))
        ;; each pasted cell is its own spawn — give it a fresh colour (sim-paste always pastes
        ;; ONE click, so a drag's crossed cells each get a distinct colour).
        [c2 n2] (color-spawn (get m :colors)
                  (get m :next-id)
                  (get (get m :board) :bits)
                  (get b2 :bits))
        m2 (assoc m :board b2 :s s2 :held [x y kind] :colors c2 :next-id n2))
    (receive
      ([:press k a b] (sim-paste m2 k a b 0))
      ([:drag k a b] (sim-paste m2 k a b newhn))
      (:stop (perflog/log-stop (get m :logger)))
      (after 0
        (if (step-due? (get m :prev))
          (sim-step (assoc m2 :hn newhn))
          (if (= :stop
                (sim-draw m b2 (get m :st) c2 (reaper-view (get m :reaper-on) (get m :reaper))))
            (perflog/log-stop (get m :logger))
            (sim-loop (assoc m2 :hn newhn))))))))

(defn sim-loop (m)
  "SIM: owns the board and PACES ITSELF. Its `receive` carries an `(after wait)` timeout that
advances + draws one generation when it fires — but any input message PREEMPTS it, so a paste
never waits. UNCAPPED — `(after 0)` steps as fast as it can draw, bounded only by the renderer's
per-frame ack. A steady drag stream would otherwise pin the mailbox and starve this `(after)`
(input is served first), freezing the world while you draw — `sim-paste` does the due step at
its own drain-idle point instead (`step-due?`), where the queue is provably clear and a fresh
drag can't preempt it. `[:press]`/`[:drag]` paste; `[:release]` clears the held cell;
`[:set-inject]` retunes auto-spawn; `[:clear]` empties the board; `:stop` ends it."
  (let ()
    (receive
      (:stop (perflog/log-stop (get m :logger)))
      ([:press kind x y] (sim-paste m kind x y 0))
      ([:drag kind x y] (sim-paste m kind x y (get m :hn)))
      ([:release] (sim-loop (assoc m :held nil)))
      ([:set-inject n] (sim-loop (assoc m :inject n)))
      ;; toggle the reaper: turning it ON seeds the age layer from the live cells (all "born now",
      ;; so they differentiate from here) and drops the reaper at the TOP-LEFT corner with no target
      ;; yet; turning it OFF drops the age layer + reaper. Footer button / `r` key, via the renderer.
      ([:toggle-reaper]
        (if (get m :reaper-on)
          (sim-loop (assoc m :reaper-on false :ages {} :reaper nil))
          (let (gen (get m :gen)
                ages (reduce (fn (a i) (assoc a i gen))
                       {}
                       (bit-positions (get (get m :board) :bits)))
                ;; anchor near-centre so the block sits FULLY in the top-left corner (cells 0..size-1)
                rp {:rx (quot *reaper-size* 2)
                    :ry (quot *reaper-size* 2)
                    :tx nil
                    :ty nil
                    :move 0
                    :face 1
                    :trail {}
                    :flash []})
            (sim-loop (assoc m :reaper-on true :ages ages :reaper rp)))))
      ;; the clear button: swap in a fresh EMPTY board (at the current dims) and draw it now —
      ;; also empties the age layer + clears the reaper's target (nothing left to reap).
      ([:clear] (let (empty (bb-make *w* *h*))
                  (if (= :stop
                        (sim-draw m
                          empty
                          (get m :st)
                          {}
                          (reaper-view (get m :reaper-on) (get m :reaper))))
                    (perflog/log-stop (get m :logger))
                    (sim-loop (assoc m
                                :board empty
                                :held nil
                                :colors {}
                                :next-id 0
                                :ages {}
                                :reaper
                                  (if (get m :reaper)
                                    (assoc (get m :reaper) :tx nil :ty nil)
                                    nil))))))
      (after 0 (sim-step m)))))

(defn quit-signal? (m)
  "Is `m` a quit signal? — the window's X (`:close`, a frontend signal distinct from the
Escape *key*), or the `q` / Esc / Ctrl-C keys."
  (or (= m :close) (= m "q") (= m :escape) (= m :ctrl-c)))

(defn render-quit (sim w)
  "Tear down: stop the sim (it owns the only timer), then close window `w`."
  (do (send sim :stop) (gui-close w)))

(defn draw! (w board info ui)
  "Paint one frame: the board (under the *view-zoom* camera) + the bar (the renderer's
buttons from `ui` + the sim's `info` string). Geometry is read from the board only."
  (gui-draw w (render board ui info)))

(defn render-mouse (w sim board info ui action button row col)
  "Route one mouse event, then redraw if the local control mirror changed and loop. Shared by
the renderer's two `[:mouse …]` arities (press carries a 7th click-count element)."
  (let ([ui2 rd] (on-mouse sim w action button row col ui))
    (do
      (when rd (draw! w board info ui2))
      (render-loop w sim board info ui2))))

(defn cells-bits (ops)
  "The live bitboard carried by the `[:cells]` op in `ops` (the uncoloured fast path), or nil
when there isn't one. Lets the renderer recover the board's bits without the SIM sending them
a second time alongside the op."
  (reduce (fn (acc o) (if (and (nil? acc) (vector? o) (= (first o) :cells)) (vector-ref o 5) acc))
    nil ops))

;; The RENDERER owns the window + input. On `[:board nl st colors ops]` it BLITS the ops the SIM
;; pre-rendered (op-building runs on the faster SIM, not the slow root), and caches the board +
;; colours so it can re-render LOCALLY on input (feedback never waits on the tick). It still
;; `grid-fit`s the window each frame; if the SIM's frame was rendered at stale dims (a resize or
;; the startup font-grid growth — `nl`'s dims ≠ the just-measured `*w*`/`*h*`), it re-renders
;; locally for that one frame so the resize fills at once, else it blits the SIM's ops. Input
;; updates the LOCAL control mirror (`ui`) and redraws at once, then messages the SIM. Never sleeps.
(defn render-loop (w sim board info ui)
  (receive
    ([:board nl0 st colors ops]
      (do
        ;; Re-read the window each frame into *w*/*h*: the cell grid grows
        ;; after the async gui-font! applies (and a font change sends no
        ;; [:resize]), so this is what makes the board FILL the window and
        ;; the bar sit at the bottom — without it *h* stays at its startup
        ;; (default-font) value and the bar floats mid-window.
        (grid-fit w)
        ;; The SIM omits `:bits` from the slim board on the uncoloured fast path (they ride in
        ;; the `[:cells]` op instead — one fewer whole-board copy per frame); recover them from
        ;; the op for the cached board that input/resize redraws read.
        (let (nl (if (get nl0 :bits) nl0 (assoc nl0 :bits (cells-bits ops)))
              onw (get nl :w)
              dims-match (and (= onw *w*) (= (get nl :h) *h*)) ; SIM's ops valid for current dims?
              nl2 (bb-fit nl *w* *h*)
              colors2 (if (= onw *w*) colors (colors-refit colors onw *w* *h*))
              ui2 (assoc ui :colors colors2))
          (do
            ;; common case: blit the SIM's pre-built ops; on a dim change, render locally so the
            ;; resize takes effect this frame (the SIM catches up to the new dims next frame).
            (if dims-match (gui-draw w ops) (draw! w nl2 st ui2))
            (send sim [:drawn])
            (render-loop w sim nl2 st ui2)))))
    ;; Resize from the EVENT's cell grid — refit the cached board to it and redraw now.
    ([:resize cols rows]
      (do
        (when (not *fixed-board*)
          (def *w* (max *grid-min* (quot cols *cell-aspect*)))
          (def *h* (max *grid-min* (max 1 (- rows *status-scale*)))))
        ;; the colour keys encode the OLD width; rekey them to the new width so
        ;; they keep matching the refit board (`nl`) on this draw and on input
        ;; redraws, until the sim resends a correctly-keyed frame.
        (let (ow (get board :w)
              nl (bb-fit board *w* *h*)
              ui2 (if (= ow *w*) ui (assoc ui :colors (colors-refit (get ui :colors) ow *w* *h*))))
          (do (draw! w nl info ui2) (render-loop w sim nl info ui2)))))
    ;; Two arities: a `:press` carries a trailing 7th element (its click-chain count), every
    ;; other action is 6 — vector patterns match by EXACT length, so both shapes need a clause
    ;; or presses (and thus every button, which fires on press) silently fall through to keys.
    ([:mouse action button row col mods] (render-mouse w sim board info ui action button row col))
    ([:mouse action button row col mods n] (render-mouse w sim board info ui action button row col))
    (m (if (quit-signal? m)
         (render-quit sim w)
         (let ([ui2 rd] (on-key sim m ui))
           (do
             (when rd (draw! w board info ui2))
             (render-loop w sim board info ui2)))))))

;; `*w*`/`*h*` — the torus `step` wraps on — are the window's BOARD area in cells: the full
;; screen grid, less the bottom *status-scale* bar rows (the VIEW zoom is a render-only
;; magnification, so it does NOT change these). FLOORED at *grid-min*² so a tiny window can't
;; collapse the torus. A resize clips/grows via bb-refit. Globals are image-wide.
(defn grid-fit (w)
  "Re-fit the sim torus to window `w`: set `*w*`/`*h*` to the board area (the window cells,
less the bar). Only `def`s when a value actually CHANGED — it runs every frame, and rebinding
a global can invalidate caches, so skip it on the common no-op frame. Returns `[cols rows]`."
  (let ([cols rows] (gui-size w)
        nw (max *grid-min* (quot cols *cell-aspect*)) ; board cols = screen cols ÷ cell aspect
        nh (max *grid-min* (max 1 (- rows *status-scale*))))
    (do
      (when (and (not *fixed-board*) (not (= nw *w*))) (def *w* nw))
      (when (and (not *fixed-board*) (not (= nh *h*))) (def *h* nh))
      [cols rows])))

(defn view-zoom! (dir mx my)
  "VIEW (camera) zoom by `dir` (+ in), clamped to [*zoom-min*, *zoom-max*] — the board is
UNCHANGED. Keep the board cell under the mouse `(mx, my)` (screen cells) fixed by panning,
then clamp the pan so the magnified window stays inside the board. A board cell is
`*cell-aspect*` screen cols wide, so the x map divides by `aspect × zoom`; y by zoom only."
  (let (z *view-zoom*
        a *cell-aspect*
        z2 (max *zoom-min* (min *zoom-max* (+ z dir)))
        bx (+ *view-ox* (quot mx (* a z))) ; board cell currently under the mouse
        by (+ *view-oy* (quot my z))
        ox (- bx (quot mx (* a z2))) ; new pan keeps that cell under the mouse at z2
        oy (- by (quot my z2)))
    (do
      (def *view-zoom* z2)
      (def *view-ox* (max 0 (min ox (max 0 (- *w* (quot *w* z2))))))
      (def *view-oy* (max 0 (min oy (max 0 (- *h* (quot *h* z2)))))))))

;; ---- PURE control math (no globals, no I/O): given a value, return the next one --------
(defn- inject-index
  (inject)
  "Index of `inject` in `*inject-presets*` (0 if it isn't one — e.g. the initial value)."
  (or (enum/index-where (fn (x) (= x inject)) *inject-presets*) 0))

(defn inject-cycle (inject)
  "The NEXT auto-spawn preset, wrapping: off → 1s → 5s → 30s → off — the `[spawn]` button."
  (vector-ref *inject-presets* (mod (+ (inject-index inject) 1) (count *inject-presets*))))

(defn inject-step (inject dir)
  "Step through the presets without wrapping: `dir` > 0 RARER (toward 30s / off), `dir` < 0
MORE OFTEN (toward 1s). Behind the `[`/`]` keys."
  (vector-ref *inject-presets*
    (max 0 (min (- (count *inject-presets*) 1) (+ (inject-index inject) dir)))))

;; ---- input → [ui' redraw?], sending the SIM throttled control messages -----------------
(defn in-footer? (row)
  "Is screen `row` in the bottom status bar? The board area is the top `*h*` screen rows (the
view zoom doesn't move the bar), so the bar begins at screen row `*h*`."
  (>= row *h*))

(defn in-range? (x [a b])
  "Is cell `x` inside the `[start end)` cell range?"
  (and (>= x a) (< x b)))

(defn footer-press (sim ui col)
  "A press in the footer: hit-test the cell `col` against the keys (the bar's screen width is
`*w*×*cell-aspect*`). Spawn cycles its preset, reaper toggles the reaper, clear empties the board."
  (let (l (footer-layout (* *w* *cell-aspect*)))
    (cond
      (in-range? col (get l :spawn))
        (let (j (inject-cycle (get ui :inject)))
          (do (send sim [:set-inject j]) [(assoc ui :inject j) true]))
      (in-range? col (get l :reaper))
        (do
          (send sim [:toggle-reaper])
          [(assoc ui :reaper-on (not (get ui :reaper-on))) true])
      (in-range? col (get l :clear)) (do (send sim [:clear]) [ui false])
      else [ui false])))

(defn footer-release (sim ui)
  "Mouse up: tell the SIM the board press ended."
  (do (send sim [:release]) [ui false]))

(defn on-mouse (sim w action button row col ui)
  "Route one mouse event to `[ui' redraw?]`. Scroll zooms; release ends a board press; a footer
press hits a button; a board press or button-held drag pastes via the SIM (left = shapes,
right = guns), drawn immediately by the sim — a bare mouse motion (no button down) drops nothing."
  (cond
    (= action :scroll-up) (do (view-zoom! *zoom-step* col row) [ui true])
    (= action :scroll-down) (do (view-zoom! (- 0 *zoom-step*) col row) [ui true])
    (= action :release) (footer-release sim ui)
    (in-footer? row) (if (= action :press) (footer-press sim ui col) [ui false])
    ;; on the board: PASTE only on a press or a drag — `:drag` always carries a held button,
    ;; and bare motion arrives as its own `:move` action (button nil), which falls to `else`
    ;; and drops nothing. Map the screen cell THROUGH the view to a BOARD cell — x = *view-ox*
    ;; + col/(aspect·z), y = *view-oy* + row/z (a board cell is *cell-aspect* screen cols wide)
    ;; — so a paste lands where you point, zoomed in or not.
    (or (= action :press) (= action :drag))
      (do
        (send sim
          [(if (= action :press) :press :drag)
            (if (= button
                  :right)
              :gun
              :shape)
            (+ *view-ox*
              (quot col (* *cell-aspect* *view-zoom*)))
            (+ *view-oy* (quot row *view-zoom*))])
        [ui false])
    else [ui false]))

(defn on-key (sim m ui)
  "Route a control key to `[ui' redraw?]`: `[`/`]` retune the auto-spawn interval, `r` toggles the
reaper (→ the SIM, the one owner). Both update the LOCAL mirror so the label flips at once (the
reaper sprite itself is drawn from the SIM's frames)."
  (cond
    (or (= m "[") (= m "]"))
      (let (j (inject-step (get ui :inject) (if (= m "[") 1 -1)))
        (do (send sim [:set-inject j]) [(assoc ui :inject j) true]))
    (= m "r")
      (do
        (send sim [:toggle-reaper])
        [(assoc ui :reaper-on (not (get ui :reaper-on))) true])
    else [ui false]))

(defn env-blank? (s)
  "Is env-var value `s` absent (nil) or the empty string?"
  (or (nil? s) (= s "")))

(defn env-board ()
  "Parse `LIFE_BOARD` (\"WxH\" or a single \"N\" for a square) into `[w h]`, or nil when unset —
the fair-comparison board pin shared with the .NET port."
  (let (s (getenv "LIFE_BOARD"))
    (if (env-blank? s)
      nil
      (let (parts (string/split s "x"))
        (if (= (count parts) 2)
          [(string->number (first parts)) (string->number (second parts))]
          (let (n (string->number s)) [n n]))))))

(defn env-int (name dflt)
  "Read integer env var `name`, or `dflt` when unset/empty."
  (let (s (getenv name)) (if (env-blank? s) dflt (string->number s))))

(defn seed-block (w h n)
  "A `w`×`h` board with a centred solid `n`×`n` block of live cells — the deterministic
fair-comparison start (identical to the .NET port's `--block` seed)."
  (let (pat (mapcat (fn (dy) (map (fn (dx) [dx dy]) (range n))) (range n))
        cx (quot (- w n) 2)
        cy (quot (- h n) 2))
    (bb-place (bb-make w h) pat cx cy)))

(defn run-life ()
  "Wire up the two actors and become the RENDERER. The SIM owns the board and paces ITSELF
with a self-resetting `(after)` timer that input preempts (so pastes are instant); this
process draws + handles input. The window cell font is set ONCE; the scroll wheel is a
render-only *view-zoom* camera (the board is unchanged)."
  (let (w (gui-open "Brood Life" 1920 1200) ; title + a big (screen-filling) window
        _ (gui-icon! w (icon-rgba) *icon-size* *icon-size*) ; the taskbar/title-bar glider icon
        _ (gui-font! w {:family :mono :height *board-height*}) ; the FIXED window font (board only)
        ;; FAIR-COMPARISON pin: if LIFE_BOARD is set, lock *w*/*h* to it (so grid-fit / resize
        ;; leave them alone); else size to the window as usual.
        fb (env-board)
        _ (def *fixed-board* fb)
        _ (def *steps-per-frame* (max 1 (env-int "LIFE_STEPS" 1))) ; gens per DRAWN frame
        _ (def *flat-render* (> (env-int "LIFE_FLAT" 0) 0)) ; force the GPU-drawable [:cells] path
        _ (if fb (do (def *w* (first fb)) (def *h* (second fb))) (grid-fit w))
        blk (env-int "LIFE_BLOCK" 0) ; seed a centred solid blk×blk block (0 = the normal empty start)
        inj (if (> blk 0) 0 *inject-secs*) ; block seed ⇒ deterministic: no auto-inject
        start (now-ns)
        board (if (> blk 0) (seed-block *w* *h* blk) (bb-make *w* *h*)) ; START EMPTY unless seeded
        me (self) ; this root process is the renderer
        logger (perflog/log-start *log-path*)
        ;; the SIM's whole state in ONE map (see `sim-step`) — the PRNG seed is the start
        ;; timestamp, `prev`/`last-inj` start there too, and it carries the fps `cap` and paces
        ;; itself. Every loop function takes this map and recurses with only the keys it changed.
        sim (spawn
              (sim-loop
                {:renderer me
                 :logger logger
                 :board board
                 :s start
                 :gen 0
                 :prev start
                 :held nil
                 :hn 0
                 :inject inj
                 :last-inj start
                 :st ""
                 :colors {}
                 :next-id 0
                 :reaper-on false ; the roving reaper, toggled by the footer / `r`
                 :ages {} ; the cell-age layer (bit index → birth-gen), only while on
                 :reaper nil ; reaper state {:rx :ry :tx :ty :move :face :trail :flash}
                 :souls 0})))
    ; lifetime count of cells the reaper has reaped
    ;; the renderer keeps a LOCAL mirror of inject (for the instant spawn-button label) plus the
    ;; spawn-colour layer the sim sends with each frame (for input redraws).
    (render-loop w
      sim
      board
      ""
      {:inject inj
       :colors {}
       :reaper-on false}))) ; LOCAL mirror for the [reaper] button label (the sprite rides the sim frames)
