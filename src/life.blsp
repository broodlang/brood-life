(defmodule life
  "Conway's Game of Life on a wrapping torus, animated in a native GUI window. The
board is a packed BITBOARD (see `bitboard`) fit to the window. It starts EMPTY — LEFT
click/drag drops random shapes, RIGHT click/drag drops glider guns, holding either
auto-repeats (throttled), and the SCROLL wheel zooms the board. Keys: `-`/`=` lower/raise
an (opt-in) fps cap, `[`/`]` make the auto-spawn rarer/more-often. It runs UNCAPPED by
default (fast — instant drawing); the footer stays a fixed height while only the board zooms."
  (:use editor/display))

(require 'bitboard)  ; the packed-bitboard board: make / bset / place / step / cells / live-count
(require 'shapes)  ; still-life / oscillator / spaceship / methuselah patterns (*shapes*) — left click
(require 'guns)  ; glider-gun patterns (*shooters*) — right click, and sown by inject-pattern
(require 'perflog)  ; tiny file logger — the stats process writes a perf line to life.log

(def *w* 120)
(def *h* 40)
;; The frame-rate cap. DEFAULT 0 = UNCAPPED (go ham — steps as fast as it can draw, which
;; keeps drawing/mouse feedback instant); a POSITIVE value paces the sim by sleeping out the
;; rest of each frame's budget, to slow the sim down enough to watch. Adjustable live with
;; `-`/`=` (slower/faster; `=` past *fps-max* rolls back to uncapped). *frame-ns* below is a
;; FIXED nominal budget used ONLY for spike detection — independent of the cap.
(def *target-fps* 0)  ; 0 = uncapped (default); >0 = the fps cap
(def *fps-min* 1)
(def *fps-max* 120)
(def *fps-step* 5)  ; fps per `-`/`=` press
(def *frame-ns* (quot 1000000000 30))  ; nominal ~33ms frame budget — for spike counting only
(def *board-height* 5)  ; the FIXED window cell-font px (set once) — small ⇒ dense board cells
;; Scroll-wheel zoom is brood-edit's way (ADR-079): the WINDOW FONT never changes — so the
;; status bar never reflows or jumps; the zoom is SEAMLESS — only the BOARD is drawn larger.
;; Each board cell is rendered at per-op `:scale *board-zoom*` (a z×z screen-cell block), so
;; the torus is cols/z × rows/z cells: zoom IN ⇒ bigger cells, fewer of them, the overflow
;; dropped (bitboard/refit clips). Clamped to [*zoom-min*, *zoom-max*].
(def *board-zoom* 1)  ; board-cell magnification (1 = native dense; higher = zoomed in)
(def *zoom-min* 1)
(def *zoom-max* 10)
(def *zoom-step* 1)
;; The bottom status bar is a FIXED *status-scale* screen-cells tall at the FIXED window
;; font, so its pixel height is constant and zoom never touches it (the seamless win).
(def *status-scale* 4)  ; the bar's height in (constant) screen cells / its glyph scale
(def *status-face* {:reverse true})  ; the bottom bar: reverse-video, like the brood-edit mode line
(def *grid-min* 5)  ; the sim torus never shrinks below *grid-min* x *grid-min*
(def *seed-cells* 3000)  ; target initial ACTIVE (live) cell count — `seed` sows random
; shapes until ~this many cells are live (the working population we pace to 30 fps).
; Capped to ~90% of the torus area so a board smaller than this can't loop forever.
;; A STATIONARY hold auto-repeats like a keyboard key: the press lands a shape AT ONCE,
;; then nothing for *hold-delay* gens (so a quick click stays a single drop), then a repeat
;; every *spawn-every* gens. Dragging is DRAWING — one shape per cell crossed — and does
;; NOT re-arm the delay, so when a drag stops the auto-repeat picks straight up at the
;; throttle rate; only a fresh press restarts the warm-up delay.
(def *hold-delay* 12)  ; gens to hold before auto-repeat starts (~0.4 s at 30 fps)
(def *spawn-every* 6)  ; gens between repeats once it's going (~5/s at 30 fps)
;; Auto-inject: drop a random pattern every *inject-secs* seconds to keep the board lively
;; on its own (0 = NEVER — the default; you drive it). Adjustable live with `[` (less often,
;; rolling past *inject-max* back to never) and `]` (more often; from never it switches on).
(def *inject-secs* 0)  ; seconds between random auto-injects (0 = never)
(def *inject-max* 30)
;; The bottom bar leads with two clickable BUTTONS — a SPAWN toggle and an FPS control
;; (click cycles a preset, drag scrubs). They're light raised KEYS overlaid on the reverse
;; bar, drawn *btn-inset* scale-steps SMALLER than the bar — so the bar shows as a margin
;; around AND a shelf below each key (spacing + a beveled, inset look). `footer-layout`
;; computes their cell columns + scale ONCE, and both the renderer and the click hit-test
;; use it. The RENDERER owns these values for instant labels and messages the SIM on every
;; change (throttled to *fps-throttle-ns* while dragging).
(def *btn-inset* 1)  ; how many scale-steps smaller the keys are than the bar (1 ⇒ a shelf below)
(def *btn-face* {:bg :white :fg :black :bold true})  ; a light raised KEY on the reverse bar
(def *fps-throttle-ns* 50000000)  ; ≥50 ms between [:set-fps] messages while dragging
(def *status-every* 10)  ; stats push the bar every N gens (~3 Hz at 30 fps) — readable, not a blur
(def *log-every* 30)  ; stats write a perf line to life.log every N gens (~1 Hz at 30 fps)
(def *log-path* "life.log")  ; where the perf log is written (cwd; truncated each run)

;; Everything sowable mid-run: the still-lifes / oscillators / spaceships of `*shapes*`
;; plus the glider guns of `*shooters*` (both required above). `inject-pattern` samples
;; this uniformly, so any known shape can drop onto the board for variety, and a gun
;; lands often enough to keep re-energising a settling board.
(def *patterns* (concat *shapes* *shooters*))

;; The generation step is `bitboard/step` (one bit-plane neighbour sum over the packed
;; rows — cost independent of population); torus wrapping lives entirely in `bitboard`
;; (its row shifts wrap east/west, `place`/`refit` wrap or clip with `mod`/range checks).

(defn seed--sow (s acc target)
  "Sow random shapes at random positions, threading the PRNG `s`, until the bitboard
`acc` holds at least `target` live cells; returns the board. Used by the test suite
(the live app starts empty — see `run-life`)."
  (if (>= (bitboard/live-count acc) target)
    acc
    (let ([shape s1] (sample s *shapes*)
          [x s2] (rand-int s1 *w*)
          [y s3] (rand-int s2 *h*))
      (seed--sow s3 (bitboard/place acc shape x y) target))))

(defn seed (s)
  "A random board: known shapes scattered across the torus until ~*seed-cells* cells
are live — capped to ~90% of the torus area (floored at 4) so a small board still seeds."
  (seed--sow s (bitboard/make *w* *h*) (max 4 (min *seed-cells* (floor (* 0.9 (* *w* *h*)))))))

;; Pattern GEOMETRY lives in the `shapes` / `guns` modules; placement is `life`'s job
;; (it needs the torus `*w*`/`*h*` and `bitboard/place`). The sim calls this on a schedule
;; both for visual variety and to revive a stagnant board (a gun lands eventually and
;; re-energises it).
(defn inject-pattern (live s)
  "Sow a random known pattern — any of `*patterns*` — at a random torus position onto
bitboard `live`, threading the PRNG `s`; returns `[live' s']`."
  (let ([pat s1] (sample s *patterns*)
        [x s2] (rand-int s1 (get live :w))
        [y s3] (rand-int s2 (get live :h)))
    [(bitboard/place live pat x y) s3]))

;; The two CLICKABLE button labels — fixed width (11 + 9 chars) so the layout/hit ranges
;; stay put as the numbers change; `pad-left` holds the value column. They take the value to
;; show (the renderer's LOCAL copy) rather than reading a global, so the renderer can repaint
;; them the instant you click/drag, ahead of the sim.
(defn spawn-label (inject)
  (str " spawn " (if (> inject 0) (str (pad-left (str inject) 2) "s") "off") " "))

(defn fps-label (cap)
  (str " fps " (pad-left (if (> cap 0) (str cap) "max") 3) " "))

;; The footer's CELL layout at the current scale, the single source of truth for both the
;; renderer and the click hit-test. The keys are *btn-inset* steps smaller than the bar, so
;; each char is `bs` cells; `m`-cell bar margins sit around/between them; `voff` drops the
;; (shorter) key to sit in the bar with a shelf below; `info-char` is where the full-scale
;; info text starts, clear of the keys (in bar-chars, ceil'd).
(defn footer-layout ()
  (let (bs (max 1 (- *status-scale* *btn-inset*))
        m bs
        sw (* (string-length (spawn-label 0)) bs)
        fw (* (string-length (fps-label 0)) bs)
        sx0 m
        sx1 (+ sx0 sw)
        fx0 (+ sx1 m m)
        fx1 (+ fx0 fw)
        infocell (+ fx1 m m))
    {:bs bs
     :voff (quot (- *status-scale* bs) 2)
     :spawn [sx0 sx1]
     :fps [fx0 fx1]
     :info-char (quot (+ infocell (- *status-scale* 1)) *status-scale*)}))

;; The INFO half of the bar (gen / measured fps / cells / spikes / memory). The two buttons
;; are prepended by the renderer (`footer-ops`), not here — STATS only knows the
;; measurement; the renderer owns the control values. (No GC field: `gc-stats` is dev-only.)
(defn status (gen cells per spikes)
  "The info fields of the bottom strip from one generation's measurement (`per` = ns since
the previous frame). The renderer composes this after the buttons."
  (str "gen "
    gen
    " · "
    (quot 1000 (max 1 (quot per 1000000)))
    " fps · "
    cells
    " cells · "
    spikes
    " spikes · "
    (quot (mem-bytes) 1048576)
    " MB"))

;; The bottom bar as render ops: a full-width reverse `bar` holding the INFO (shifted past
;; the keys so it can't underlap), then the two SMALLER keys OVERLAID in *btn-face* at the
;; cell columns `footer-layout` computes, dropped by `voff` so the bar shows as a shelf below
;; them. `top`/`vcols` come from the board being drawn (`render`), so the bar is always
;; positioned consistently with the board — no resize jump.
(defn footer-ops (ui info top vcols)
  (let (l (footer-layout)
        bs (get l :bs)
        face (assoc *btn-face* :scale bs)
        [sx0 _] (get l :spawn)
        [fx0 _] (get l :fps)
        brow (+ top (get l :voff))
        bg (bar top
             vcols
             (str (string-repeat " " (get l :info-char)) info)
             {:face *status-face* :align :left :scale *status-scale*}))
    [bg [:text brow sx0 (spawn-label (get ui :inject)) face]
      [:text brow fx0 (fps-label (get ui :cap)) face]]))

;; The leading `clear` wipes the previous frame, so we paint only what's lit. ALL geometry
;; comes from `live` itself (`:h`/`:w`) scaled by *board-zoom*, so the board and the bar
;; below it are sized from ONE snapshot — the brood-edit anti-jitter rule: never composite a
;; stale board under a freshly-measured bar position (that mismatch made the footer jump).
;; Each live cell is one `:text` op magnified by `z` (a z×z block at z=*board-zoom*), the
;; brood-edit `:scale` zoom (ADR-079): the window grid is fixed, so the bar never reflows.
(defn render (live ui info)
  "A display frame from `live`: each live cell a `:text` op scaled by *board-zoom*, then the
bottom bar (buttons + `info`) at the board's scaled bottom. Geometry from `live` only."
  (let (z *board-zoom*
        rows (get live :rows)
        h (get live :h)
        wdt (get live :w)
        ;; hoist the per-cell op builder so the z=1 hot path stays a bare 3-element op
        cell (if (= z 1)
               (fn (y x) [:text y x "▪"])
               (fn (y x) [:text (* y z) (* x z) "▪" {:scale z}])))
    (into (into [(clear)]
            (mapcat (fn (y)
                      (let (r (vector-ref rows y))
                        (if (= r 0) nil (map (fn (x) (cell y x)) (bit-positions r)))))
              (range h)))
      (footer-ops ui info (* h z) (* wdt z)))))

;; ---- the actors: SIM (model + clock) → STATS → RENDERER (compositor) -------------
;; Each source is its own process that PUSHES updates to a thin renderer (ADR-058
;; concurrency); the renderer owns the window and composites.

(defn log-fmt (gen cells per spikes)
  "A compact, tab-separated perf line for the debug log — one column per field, so it
greps/plots cleanly (`cells` and `fps` are the headline; `ms`/gen, `spikes` and `mb`
tie a frame-rate dip to rising population or memory churn)."
  (str "gen "
    gen
    "\tcells "
    cells
    "\tfps "
    (quot 1000 (max 1 (quot per 1000000)))
    "\tms "
    (quot per 1000000)
    "\tspikes "
    spikes
    "\tmb "
    (quot (mem-bytes) 1048576)))

;; The `mem-bytes` call and the file write stay off the sim/render threads. `:stop` ends
;; it and stops the logger (flushing nothing — the buffer is already on disk).
(defn stats-loop (renderer logger)
  "STATS: formats the status line OFF the hot paths and at its OWN cadence — it sees
every generation's `[:meas …]` but only pushes `[:status …]` every `*status-every*` gens
and writes a perf line to the `logger` every `*log-every*` gens."
  (receive (:stop (perflog/log-stop logger))
    ([:meas gen cells per spikes] (do
                                    (when (= 0 (mod gen *status-every*))
                                      (send renderer [:status (status gen cells per spikes)]))
                                    (when (= 0 (mod gen *log-every*))
                                      (perflog/log-line logger (log-fmt gen cells per spikes)))
                                    (stats-loop renderer logger)))))

(defn sim-serve (renderer board s held cap inject armed due acked)
  "Hold the sim between steps WITHOUT a blocking sleep: stay responsive until `due` ns (the
next step's deadline at the current cap). A press/drag draws its pattern onto `board` and
REDRAWS it at once — so a spawn appears immediately even at a 1 fps cap, not on the next
tick — then awaits that frame's ack; release clears the held cell; `[:set-fps]`/`[:set-inject]`
retune the sim-owned controls. It drains `[:drawn]` acks and won't return until the last
board it sent is acked (`acked`), which bounds the mailbox like the old per-frame wait.
Returns `:stop`, or `[board s held cap inject armed]` at the deadline."
  (let (left (- due (now-ns)))
    (if (and acked (<= left 0))
      [board s held cap inject armed]
      (receive (:stop :stop)
        ([:drawn] (sim-serve renderer board s held cap inject armed due true))
        ([:press kind x y] (let ([b2 s2] (apply-clicks board [[x y kind]] s))
                             (do
                               (send renderer [:board b2])
                               (sim-serve renderer b2 s2 [x y kind] cap inject true due false))))
        ([:drag kind x y] (let ([b2 s2] (apply-clicks board [[x y kind]] s))
                            (do
                              (send renderer [:board b2])
                              (sim-serve renderer b2 s2 [x y kind] cap inject armed due false))))
        ([:release] (sim-serve renderer board s nil cap inject armed due acked))
        ([:set-fps n] (sim-serve renderer board s held n inject armed due acked))
        ([:set-inject n] (sim-serve renderer board s held cap n armed due acked))
        (after (if acked (max 1 (quot (max 1 left) 1000000)) 2000)
          [board s held cap inject armed])))))

(defn apply-clicks (board clicks s)
  "Drop a random pattern at each click cell `[x y kind]`, threading the PRNG `s`: a `:gun`
cell samples a glider gun (`*shooters*`, right button), any other kind samples a shape
(`*shapes*`, left button). Returns `[board' s']` — the only way cells enter the board
(the app starts empty)."
  (reduce (fn ([b s] [x y kind])
            (let (catalog (if (= kind :gun) *shooters* *shapes*)
                  [pat s1] (sample s catalog))
              [(bitboard/place b pat x y) s1]))
    [board s]
    clicks))

(defn sim-loop (renderer stats live gen prev spikes s held hn cap inject last-inj)
  "SIM: the model + the clock, OWNER of the live `cap`/`inject` (retuned only by the
renderer's messages, so input never contends with the tick). Each tick it fits + draws the
board + a measurement, then SERVES input until the next tick is due — drawing any spawn the
instant it's clicked, even at a low cap — folds in the held-cell key-repeat and the
wall-clock auto-inject, steps one generation, and recurses. `:stop` ends it."
  (let (live (bitboard/fit live *w* *h*)
        now (now-ns)
        per (- now prev)
        spk (if (> per (quot (* *frame-ns* 3) 2)) (+ spikes 1) spikes))
    (do
      (send renderer [:board live])
      (send stats [:meas gen (bitboard/live-count live) per spk])
      ;; serve input (drawing clicks immediately) until the next step is due — `due` is now
      ;; for an uncapped sim (step as soon as the draw is acked) else now + the cap's budget.
      (let (due (+ now (if (> cap 0) (quot 1000000000 cap) 0))
            served (sim-serve renderer live s held cap inject false due false))
        (if (= :stop served)
          :stopped
          (let ([cur s2 held2 cap2 inject2 armed2] served
                ;; held-cell auto-repeat: a fresh PRESS (`armed2`) re-arms (hn←0); a
                ;; stationary hold counts up and re-drops every *spawn-every* gens past the
                ;; warm-up (discrete presses/drags already drew immediately in sim-serve).
                hn2 (if armed2 0 (if held2 (+ hn 1) 0))
                repeat? (and held2
                          (>= hn2 *hold-delay*)
                          (= 0 (mod (- hn2 *hold-delay*) *spawn-every*)))
                [cur1 s3] (if repeat? (apply-clicks cur [held2] s2) [cur s2])
                ;; auto-inject on a WALL-CLOCK schedule (robust to the cap — a gen count
                ;; would divide by the fps and flood when uncapped). 0 = never.
                inj? (and (> inject2 0) (>= (- now last-inj) (* inject2 1000000000)))
                [cur2 s4] (if inj? (inject-pattern cur1 s3) [cur1 s3])
                last-inj2 (if inj? now last-inj)
                nxt (bitboard/step cur2))
            (sim-loop renderer stats nxt (+ gen 1) now spk s4 held2 hn2 cap2 inject2 last-inj2)))))))

(defn quit-signal? (m)
  "Is `m` a quit signal? — the window's X (`:close`, a frontend signal distinct from the
Escape *key*), or the `q` / Esc / Ctrl-C keys."
  (or (= m :close) (= m "q") (= m :escape) (= m :ctrl-c)))

(defn render-quit (sim stats w)
  "Tear down: stop the sim and stats actors, then close window `w`."
  (do (send sim :stop) (send stats :stop) (gui-close w)))

(defn draw! (w live info ui)
  "Composite + paint one frame: the cached board with the bottom bar = the two buttons
(from the renderer-LOCAL `ui`) + the stats `info`. Geometry is read from `live` only (so
the bar can't disagree with the board on resize). No `gui-size` here — that's `grid-fit`."
  (gui-draw w (render live ui info)))

;; The renderer owns the window and is a thin COMPOSITOR. It threads its cached board
;; (`live`), the stats `info` string, and `ui` — the LOCAL control state {:cap :inject :drag
;; :dcol :moved :sent}. It redraws on `[:board …]` (acking `[:drawn]`), on `[:status …]`, on
;; `[:resize]`, AND immediately after any footer interaction — so control feedback never
;; waits on the sim's frame rate (the bug where a low cap froze the whole UI). Input that
;; changes a control is sent to the sim as a message (throttled while dragging); the sim,
;; not this loop, owns the authoritative value. `grid-fit` only updates *w*/*h* for the sim.
(defn render-loop (w sim stats live info ui)
  (receive
    ([:board nl]
      (do
        (grid-fit w)  ; track the live window/zoom size into *w*/*h*
        ;; Draw the board at the CURRENT size, not the sim's (which fit it a frame or two
        ;; ago): refit it here so the board always fills the window and the bar — drawn from
        ;; the SAME board's dims — never lags behind a resize. (No-op when already sized.)
        (let (nl2 (bitboard/fit nl *w* *h*))
          (do
            (draw! w nl2 info ui)
            (send sim [:drawn])
            (render-loop w sim stats nl2 info ui)))))
    ([:status s] (do (draw! w live s ui) (render-loop w sim stats live s ui)))
    ;; Resize from the EVENT's cell grid (cols rows) — the authoritative new size, like the
    ;; brood-edit loop — NOT a re-query that could lag it; refit the cached board to it and
    ;; redraw now, so it fills immediately even before the sim's next frame lands.
    ([:resize cols rows] (let (z *board-zoom*
                               vrows (max 1 (- rows *status-scale*)))
                           (do
                             (def *w* (max *grid-min* (quot cols z)))
                             (def *h* (max *grid-min* (quot vrows z)))
                             (let (nl (bitboard/fit live *w* *h*))
                               (do (draw! w nl info ui) (render-loop w sim stats nl info ui))))))
    ;; One mouse dispatcher; `on-mouse` returns `[ui' redraw?]` and does any sim sends.
    ([:mouse action button row col mods] (let ([ui2 rd] (on-mouse sim w action button row col ui))
                                           (do
                                             (when rd (draw! w live info ui2))
                                             (render-loop w sim stats live info ui2))))
    ;; Keys (`-`/`=` fps, `[`/`]` spawn) route the same way via `on-key`: update the local
    ;; copy, send the sim a message, redraw. A quit signal tears everything down.
    (m (if (quit-signal? m)
         (render-quit sim stats w)
         (let ([ui2 rd] (on-key sim m ui))
           (do
             (when rd (draw! w live info ui2))
             (render-loop w sim stats live info ui2)))))))

;; `*w*`/`*h*` — the torus `step` wraps on — are the window's BOARD area in board-cells:
;; the screen grid (less the bottom *status-scale* bar rows) divided by *board-zoom*, since
;; each board cell is drawn z×z. FLOORED at *grid-min*² so a tiny window or deep zoom can't
;; collapse the torus. Shrinking clips off-board cells (bitboard/refit). Globals are
;; image-wide, so the next `step` wraps on the new size.
(defn grid-fit (w)
  "Re-fit the sim torus to window `w`: set `*w*`/`*h*` to the board area (window cells, less
the bar, divided by *board-zoom*). Returns `[cols rows]` (the raw screen grid)."
  (let ([cols rows] (gui-size w)
        z *board-zoom*
        vrows (max 1 (- rows *status-scale*)))
    (do
      (def *w* (max *grid-min* (quot cols z)))
      (def *h* (max *grid-min* (quot vrows z)))
      [cols rows])))

(defn zoom (w dir)
  "Step the board magnification by `dir` (+ zooms IN: bigger cells, fewer of them), clamped
to [*zoom-min*, *zoom-max*]. Only the BOARD scales — the window font/grid and the status bar
are untouched (seamless). The next `grid-fit` refits the torus, clipping any cells off-board."
  (def *board-zoom* (max *zoom-min* (min *zoom-max* (+ *board-zoom* dir)))))

;; ---- PURE control math (no globals, no I/O): given a value, return the next one --------
(defn fps-nudge (cap d)
  "The fps cap moved by `d` (− slower, + faster). Uncapped (0) acts as just past *fps-max*,
so + past the top returns to uncapped and − from uncapped engages the cap near the top;
otherwise clamped to [*fps-min*, *fps-max*]."
  (let (base (if (= cap 0) (+ *fps-max* 1) cap) f (+ base d))
    (if (> f *fps-max*) 0 (max *fps-min* f))))

(defn fps-cycle (cap)
  "The next fps preset for a CLICK on the button: uncapped → 30 → 10 → 1 → uncapped (any
in-between value from a drag rounds down to the next lower preset)."
  (cond (= cap 0) 30 (> cap 10) 10 (> cap 1) 1 :else 0))

(defn inject-toggle (inject)
  "Flip auto-spawn off↔on (on resumes at a sensible 5 s) — the `[spawn]` button click."
  (if (> inject 0) 0 5))

(defn inject-nudge (inject dir)
  "The auto-spawn interval moved a notch: `dir` > 0 RARER (+1 s; past *inject-max* → never),
`dir` < 0 MORE OFTEN (−1 s, floored at 1; from never → 5 s). Behind the `[`/`]` keys."
  (if (> dir 0)
    (if (>= inject *inject-max*) 0 (+ inject 1))
    (if (= inject 0) 5 (max 1 (- inject 1)))))

;; ---- input → [ui' redraw?], sending the SIM throttled control messages -----------------
(defn in-footer? (row)
  "Is screen `row` in the bottom status bar? The board is `*h*` cells tall, each drawn z
high, so the bar begins at screen row `*h*×*board-zoom*`."
  (>= row (* *h* *board-zoom*)))

(defn in-range? (x [a b])
  "Is cell `x` inside the `[start end)` cell range?"
  (and (>= x a) (< x b)))

(defn footer-press (sim ui col)
  "A press in the footer: hit-test the cell `col` against the keys' cell ranges (from
`footer-layout`). Spawn toggles (send the sim the new interval); the fps key arms a drag
(tracked in `ui`, no send yet)."
  (let (l (footer-layout))
    (cond
      (in-range? col (get l :spawn)) (let (j (inject-toggle (get ui :inject)))
                                       (do (send sim [:set-inject j]) [(assoc ui :inject j) true]))
      (in-range? col (get l :fps)) [(assoc ui :drag :fps :dcol col :moved false) true]
      :else [ui false])))

(defn fps-drag (sim ui col)
  "Continue an fps drag: update the LOCAL cap by the cells moved (instant label feedback),
and send the sim a `[:set-fps]` only every *fps-throttle-ns* so a drag can't flood it."
  (let (cap (fps-nudge (get ui :cap) (- col (get ui :dcol)))
        ui2 (assoc ui :cap cap :dcol col :moved true)
        now (now-ns))
    (if (>= (- now (get ui :sent)) *fps-throttle-ns*)
      (do (send sim [:set-fps cap]) [(assoc ui2 :sent now) true])
      [ui2 true])))

(defn footer-release (sim ui)
  "Mouse up: always tell the sim the board press ended. If an fps drag was active, settle
it — a release with no movement is a CLICK (cycle a preset), otherwise flush the final
dragged value (the debounce tail) — and clear the drag."
  (do
    (send sim [:release])
    (if (= (get ui :drag) :fps)
      (let (cap (if (get ui :moved) (get ui :cap) (fps-cycle (get ui :cap))))
        (do (send sim [:set-fps cap]) [(assoc ui :cap cap :drag nil) true]))
      [ui false])))

(defn on-mouse (sim w action button row col ui)
  "Route one mouse event to `[ui' redraw?]`, doing any sim sends. Scroll zooms; release
settles a drag; an in-progress fps drag scrubs; a footer press hits a button; anything else
is on the board and draws via the sim (left = shapes, right = guns)."
  (cond
    (= action :scroll-up) (do (zoom w *zoom-step*) [ui true])
    (= action :scroll-down) (do (zoom w (- 0 *zoom-step*)) [ui true])
    (= action :release) (footer-release sim ui)
    (= (get ui :drag) :fps) (if (= action :drag) (fps-drag sim ui col) [ui false])
    (in-footer? row) (if (= action :press) (footer-press sim ui col) [ui false])
    ;; on the board: map the screen cell to a BOARD cell (÷ *board-zoom*, since each board
    ;; cell is drawn that many screen cells wide/high) before forwarding it to the sim.
    :else (do
            (send sim
              [(if (= action :press) :press :drag) (if (= button :right) :gun :shape)
                (quot col *board-zoom*)
                (quot row *board-zoom*)])
            [ui false])))

(defn on-key (sim m ui)
  "Route a control key to `[ui' redraw?]`: `-`/`=` nudge the fps cap, `[`/`]` the auto-spawn
interval. Like the buttons, this updates the LOCAL copy and messages the sim."
  (cond
    (= m "-") (let (c (fps-nudge (get ui :cap) (- 0 *fps-step*)))
                (do (send sim [:set-fps c]) [(assoc ui :cap c) true]))
    (= m "=") (let (c (fps-nudge (get ui :cap) *fps-step*))
                (do (send sim [:set-fps c]) [(assoc ui :cap c) true]))
    (= m "[") (let (j (inject-nudge (get ui :inject) 1))
                (do (send sim [:set-inject j]) [(assoc ui :inject j) true]))
    (= m "]") (let (j (inject-nudge (get ui :inject) -1))
                (do (send sim [:set-inject j]) [(assoc ui :inject j) true]))
    :else [ui false]))

(defn run-life ()
  "Wire up and run the three actors. This root process becomes the RENDERER (it owns the
window). The window cell font is set ONCE to *board-height* and never changes — zoom is the
per-op `:scale` of *board-zoom*, so the bar never reflows. We `grid-fit` once to size
`*w*`/`*h*`, start EMPTY (click to drop shapes), then spawn stats + sim."
  (let (w (gui-open "Brood Life")  ; the OS title-bar text (gui-title! could change it later)
        _ (gui-font! w {:family :mono :height *board-height*})  ; the FIXED window font (board only)
        _ (grid-fit w)  ; sizes *w*/*h* before we build the board
        start (now-ns)
        board (bitboard/make *w* *h*)  ; START EMPTY — clicks add random shapes
        me (self)  ; this root process is the renderer
        stats (spawn (stats-loop me (perflog/log-start *log-path*)))
        ;; the sim owns the live cap (*target-fps*) + auto-spawn interval (*inject-secs*) and
        ;; its last-inject clock (start), updated only by the renderer's messages.
        sim (spawn (sim-loop me
                     stats
                     board
                     0
                     (- start *frame-ns*)
                     0
                     start
                     nil
                     0
                     *target-fps*
                     *inject-secs*
                     start)))
    ;; the renderer keeps a LOCAL mirror of those values (for instant button labels) plus the
    ;; transient drag state, and an empty info string until stats pushes the first one.
    (render-loop w
      sim
      stats
      board
      ""
      {:cap *target-fps* :inject *inject-secs* :drag nil :dcol 0 :moved false :sent 0})))
