(defmodule bitboard
  "Conway's Game of Life board as a WIDE-ROW bitboard: one arbitrary-precision
integer per row, bit x = cell `(x,y)` alive. A board is a record `{:w :h :mask
:rows}` — `:rows` a vector of `:h` big-ints, `:mask` = 2^w − 1.

`step` computes a whole generation as one bit-plane full-adder neighbour sum per
row over the three torus-wrapped rows — O(h) big-int ops, INDEPENDENT of how many
cells are live (a sparse map's step grows with population; a chunked bitboard's
grows with board area; this is flat). Needs the kernel's arbitrary-precision
integers + unrestricted shifts (one row is a w-bit number, shifted by w−1 to wrap
the torus) and `bit-positions` (so rendering is O(live), not O(area)).")

(defn make (w h)
  "An empty `w`×`h` bitboard."
  {:w w :h h :mask (- (bit-shift-left 1 w) 1) :rows (into [] (map (fn (_) 0) (range h)))})

(defn bset (board x y)
  "Set cell `(x,y)` live; returns the new board. Caller wraps `x`/`y` into range."
  (let (rows (get board :rows))
    (assoc board :rows
      (vector-assoc rows y (bit-or (vector-ref rows y) (bit-shift-left 1 x))))))

(defn place (board pat x y)
  "Set every cell of pattern `pat` (a list of `[dx dy]`) at origin `(x,y)`, wrapped."
  (let (w (get board :w) h (get board :h))
    (reduce (fn (b [dx dy]) (bset b (mod (+ x dx) w) (mod (+ y dy) h))) board pat)))

(defn live-count (board)
  "Population: the number of live cells (popcount of every row, via `bit-count`)."
  (reduce (fn (a r) (+ a (bit-count r))) 0 (get board :rows)))

;; The west / east neighbour masks of a w-bit row, torus-wrapped: west shifts every
;; cell one column up (bit x ← x−1), wrapping the top bit (x=w−1) round to bit 0;
;; east is the mirror. `wm1` is w−1 (the wrap shift), `mask` keeps it w bits wide.
(defn bb--west (r mask wm1) (bit-and (bit-or (bit-shift-left r 1) (bit-shift-right r wm1)) mask))
(defn bb--east (r mask wm1) (bit-and (bit-or (bit-shift-right r 1) (bit-shift-left r wm1)) mask))

;; The next state of a whole row: sum its 8 neighbour-row-masks into 4 bit-planes
;; with full-adders, then a cell lives iff the count is 3, or 2 and it's already
;; live → `s1 & ~s2 & ~s3 & (s0 | cur)`, masked to w bits (`~` is `xor mask`).
(defn bb--row-next (above cur below mask wm1)
  (let (masks [(bb--west above mask wm1) above (bb--east above mask wm1)
               (bb--west cur mask wm1) (bb--east cur mask wm1)
               (bb--west below mask wm1) below (bb--east below mask wm1)]
        planes (reduce (fn ([s0 s1 s2 s3] m)
                         (let (c (bit-and s0 m) s0b (bit-xor s0 m)
                               c2 (bit-and s1 c) s1b (bit-xor s1 c)
                               c3 (bit-and s2 c2) s2b (bit-xor s2 c2)
                               s3b (bit-or s3 c3))
                           [s0b s1b s2b s3b]))
                 [0 0 0 0] masks)
        s0 (vector-ref planes 0) s1 (vector-ref planes 1)
        s2 (vector-ref planes 2) s3 (vector-ref planes 3))
    (bit-and (bit-and s1 (bit-and (bit-xor s2 mask) (bit-xor s3 mask)))
             (bit-or s0 cur))))

(defn bb--step-row (y rows zero h mask wm1)
  "The next state of row `y`. An empty 3-row band (above/self/below all zero)
produces an empty row with no work, so a sparse board costs ~O(live rows)."
  (let (a (mod (- y 1) h) b (mod (+ y 1) h))
    (if (and (vector-ref zero a) (vector-ref zero y) (vector-ref zero b))
      0
      (bb--row-next (vector-ref rows a) (vector-ref rows y) (vector-ref rows b) mask wm1))))

(defn step (board)
  "Advance one generation. O(h) big-int neighbour sums, independent of population."
  (let (h (get board :h) mask (get board :mask) wm1 (- (get board :w) 1) rows (get board :rows)
        zero (into [] (map (fn (y) (= 0 (vector-ref rows y))) (range h))))
    (assoc board :rows
      (into [] (map (fn (y) (bb--step-row y rows zero h mask wm1)) (range h))))))

(defn cells (board)
  "A list of live `[x y]` cells — O(live), via `bit-positions` per non-empty row."
  (let (rows (get board :rows))
    (mapcat (fn (y)
              (let (r (vector-ref rows y))
                (if (= r 0) nil (map (fn (x) [x y]) (bit-positions r)))))
      (range (get board :h)))))

(defn refit (board w h)
  "Rebuild `board` at new dims (a window resize), torus-wrapping out-of-range cells."
  (reduce (fn (b [x y]) (bset b (mod x w) (mod y h))) (make w h) (cells board)))

(defn fit (board w h)
  "`board` if it already has dims `w`×`h`, else `refit` to them."
  (if (and (= (get board :w) w) (= (get board :h) h)) board (refit board w h)))
