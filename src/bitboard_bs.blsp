(defmodule bitboard-bs
  "Conway's Game of Life board as a refc-shared BITSET — the API-compatible twin of
`bitboard` (the bignum version), differing only in representation. `:bits` (and the torus
edge masks `:board`/`:mask`/`:col0`/`:high`) are `bitset`s: fixed-size bit arrays backed by
a shared blob. The point is the process seam — a bitset crosses `send`/`table` BY REFERENCE
(an Arc refcount bump), where the bignum board deep-copies (it serialises to a decimal
string: ~1.28 ms for a 256² board vs ~0.002 ms for the bitset). The whole bit-plane torus
step runs in ONE native op (`bitset-life-step`): the Moore-8 neighbour sum + the B3/S23
survival rule over the byte buffer — measured FASTER than the bignum step too (~0.11 ms vs
~0.13 ms at 256²). So the board is a strict win on both axes: cheaper to step AND to share.")

(defn make (w h)
  "An empty `w`×`h` bitset board, with the torus edge masks precomputed as bitsets:
`:board` = all `w*h` bits, `:mask` = the low `w` bits (one row), `:col0`/`:high` = each
row's x=0 / x=w−1 bit."
  (let (n (* w h) z (bitset n))
    {:w w :h h :n n
     :board (bitset-ones n)
     :mask (reduce (fn (b x) (bitset-set b x)) z (range w))
     :col0 (reduce (fn (b y) (bitset-set b (* y w))) z (range h))
     :high (reduce (fn (b y) (bitset-set b (+ (* y w) (- w 1)))) z (range h))
     :bits z}))

(defn bset (board x y)
  "Set cell `(x,y)` live; returns the new board. Caller wraps `x`/`y` into range."
  (assoc board :bits (bitset-set (get board :bits) (+ x (* y (get board :w))))))

(defn place (board pat x y)
  "Set every cell of pattern `pat` (a list of `[dx dy]`) at origin `(x,y)`, wrapped."
  (let (w (get board :w) h (get board :h))
    (reduce (fn (b [dx dy]) (bset b (mod (+ x dx) w) (mod (+ y dy) h))) board pat)))

(defn live-count (board)
  "Population: the number of live cells — one native popcount of the bitset."
  (bitset-count (get board :bits)))

(defn step (board)
  "Advance one generation. The whole bit-plane full-adder torus step + B3/S23 survival in
ONE native op over the byte buffer — independent of population."
  (assoc board :bits
    (bitset-life-step (get board :bits) (get board :col0) (get board :high)
      (get board :mask) (get board :board) (get board :w) (get board :h))))

(defn cells (board)
  "A list of live `[x y]` cells — O(live), via one native `bitset-positions`."
  (let (w (get board :w))
    (map (fn (i) [(mod i w) (quot i w)]) (bitset-positions (get board :bits)))))

(defn refit (board w h)
  "Rebuild `board` at new dims, DROPPING cells that fall outside the new `w`×`h`."
  (reduce (fn (b [x y]) (if (and (< x w) (< y h)) (bset b x y) b)) (make w h) (cells board)))

(defn fit (board w h)
  "`board` if it already has dims `w`×`h`, else `refit` to them."
  (if (and (= (get board :w) w) (= (get board :h) h)) board (refit board w h)))
